{
  "name": "wbc-training-center",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "node --watch apps/api/src/server.ts",
    "build:miniapp": "node apps/miniapp/scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -p apps/miniapp/tsconfig.json --noEmit",
    "test": "node --test apps/api/test/*.test.ts apps/miniapp/test/*.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "miniprogram-api-typings": "5.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "version": "1.1.3"
}
