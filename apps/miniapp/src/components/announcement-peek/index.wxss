.header { position:relative; display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
.heading { font-size:28px; font-weight:700; letter-spacing:-.65px; }
button { color:#761f32; font-size:14px; background:transparent; padding:0 4px; margin:0; line-height:44px; min-height:44px; font-weight:600; }
button::after { border:0; }
.header .entry { display:flex; flex:0 0 auto; width:auto; min-width:44px; height:44px; margin:0 0 0 auto; padding:0 0 0 8px; align-items:center; justify-content:flex-end; gap:6px; font-size:14px; line-height:1.4; }
.actions button { flex:0 0 auto; width:auto; margin:0; padding:0; min-width:44px; font-size:14px; }
.actions button:last-child { text-align:right; }
.dot { width:7px; height:7px; background:#a02c43; border-radius:50%; }
.peek { position:absolute; z-index:4; right:0; top:100%; width:90%; box-sizing:border-box; max-width:360px; padding:11px 14px 2px; background:white; border:1px solid #d9c3c5; border-radius:9px; box-shadow:0 5px 16px rgba(79,25,36,.14); }
.peek::before { content:""; position:absolute; top:-5px; right:17px; width:8px; height:8px; transform:rotate(45deg); background:white; border-top:1px solid #d9c3c5; border-left:1px solid #d9c3c5; }
.meta,.actions { display:flex; align-items:center; justify-content:space-between; }
.meta { font-size:12px; color:#761f32; }
.meta text:last-child,.actions button:last-child { color:#695d61; }
.title { font-size:18px; font-weight:650; margin:4px 0; word-break:break-all; }
.excerpt { overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.full { max-height:32vh; white-space:pre-wrap; }
.full,.excerpt { font-size:15px; overflow-wrap:anywhere; }
