page {
  background: #f8f6f3;
  color: #272327;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.7;
}

.page-shell {
  box-sizing: border-box;
  max-width: 960rpx;
  margin: 0 auto;
  padding: 36rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: block;
  margin: 0 0 34rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1rpx;
}

.section-title {
  margin: 48rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.muted {
  color: #66595c;
  font-size: 28rpx;
}

.accent {
  color: #761f32;
  font-weight: 650;
}

.button {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: #761f32;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.6;
}

.button::after {
  border: 0;
}

.button.quiet {
  border-color: #d5c4c5;
  background: #fff;
  color: #761f32;
}

button.button[disabled] {
  background: #ede7e5;
  color: #6c6063;
}

.press {
  opacity: .83;
}

.field, .picker {
  box-sizing: border-box;
  min-height: 92rpx;
  padding: 21rpx 26rpx;
  border: 1rpx solid #d5c4c5;
  border-radius: 16rpx;
  background: #fff;
  color: #272327;
}

.field {
  height: 92rpx;
  padding: 0 26rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.picker-label {
  flex-shrink: 0;
  color: #66595c;
  font-size: 28rpx;
}

.picker-value {
  font-weight: 600;
  text-align: right;
}

.message {
  margin: 32rpx 0;
  padding: 24rpx 0;
  color: #66595c;
}

.message .button {
  margin-top: 16rpx;
}

.list-row {
  padding: 34rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

.row-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.row-name {
  font-weight: 650;
}

.row-action {
  margin-top: 24rpx;
}

.form-field {
  display: block;
  margin: 30rpx 0;
}

.form-field .field {
  margin-top: 12rpx;
}

.list-row > .muted, .list-row > .row-line + view {
  margin-top: 8rpx;
}

.form-error {
  margin: 24rpx 0;
  color: #761f32;
  overflow-wrap: anywhere;
}

.section-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 32rpx;
}

.section-actions .button {
  flex: 1 1 180rpx;
}

.subheading {
  margin: 32rpx 0 14rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.details {
  margin: 18rpx 0 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #f0eae8;
  color: #524549;
  overflow-wrap: anywhere;
}

.filter-row {
  margin: 24rpx 0;
}

.selection-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0 22rpx;
}

.selection-grid .button {
  flex: 0 0 auto;
  min-width: 76rpx;
  padding-right: 14rpx;
  padding-left: 14rpx;
}

.action-link {
  display: block;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

/* A single class, booking, or availability window. */
.lesson-card {
  display: block;
  box-sizing: border-box;
  margin: 18rpx 0;
  padding: 28rpx;
  border: 1rpx solid #ded5d3;
  border-radius: 22rpx;
  background: #fff;
  overflow-wrap: anywhere;
}

.lesson-card .card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.35;
}

.card-time {
  display: block;
  color: #761f32;
  font-size: 30rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.card-note, .card-state {
  color: #66595c;
  font-size: 26rpx;
}

.card-state {
  flex-shrink: 0;
  font-weight: 600;
}

.card-head + .card-time, .card-head + .card-note, .card-time + .card-title {
  margin-top: 8rpx;
}

.card-footer {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e6dfdc;
}

.lesson-card .section-actions {
  margin-bottom: 0;
}

.card-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.card-fields .field {
  width: 100%;
}

.coach-face {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #f0e4e5;
  color: #761f32;
  font-size: 36rpx;
  font-weight: 650;
}

.coach-face image {
  display: block;
  width: 100%;
  height: 100%;
}

.utility-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0 32rpx;
  margin-top: 28rpx;
  color: #66595c;
  font-size: 26rpx;
  text-align: left;
}

.utility-links > navigator, .utility-links > text {
  padding: 12rpx 0;
}
