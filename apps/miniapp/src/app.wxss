page {
  background: #f8f6f3;
  color: #272327;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.7;
}

.page-shell {
  box-sizing: border-box;
  max-width: 960rpx;
  margin: 0 auto;
  padding: 36rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: block;
  margin: 0 0 34rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1rpx;
}

.section-title {
  margin: 48rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.muted {
  color: #66595c;
  font-size: 28rpx;
}

.accent {
  color: #761f32;
  font-weight: 650;
}

.button {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: #761f32;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.6;
}

.button::after {
  border: 0;
}

.button.quiet {
  border-color: #d5c4c5;
  background: #fff;
  color: #761f32;
}

button.button[disabled] {
  background: #ede7e5;
  color: #6c6063;
}

.press {
  opacity: .83;
}

.field, .picker {
  box-sizing: border-box;
  min-height: 92rpx;
  padding: 21rpx 26rpx;
  border: 1rpx solid #d5c4c5;
  border-radius: 16rpx;
  background: #fff;
  color: #272327;
}

.field {
  height: 92rpx;
  padding: 0 26rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.picker-label {
  flex-shrink: 0;
  color: #66595c;
  font-size: 28rpx;
}

.picker-value {
  font-weight: 600;
  text-align: right;
}

.message {
  margin: 32rpx 0;
  padding: 24rpx 0;
  color: #66595c;
}

.message .button {
  margin-top: 16rpx;
}

.list-row {
  padding: 34rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

.row-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.row-name {
  font-weight: 650;
}

.row-action {
  margin-top: 24rpx;
}

.form-field {
  display: block;
  margin: 30rpx 0;
}

.form-field .field {
  margin-top: 12rpx;
}

.list-row > .muted, .list-row > .row-line + view {
  margin-top: 8rpx;
}

.form-error {
  margin: 24rpx 0;
  color: #761f32;
  overflow-wrap: anywhere;
}

.section-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 32rpx;
}

.section-actions .button {
  flex: 1 1 180rpx;
}

.subheading {
  margin: 32rpx 0 14rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.details {
  margin: 18rpx 0 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #f0eae8;
  color: #524549;
  overflow-wrap: anywhere;
}

.filter-row {
  margin: 24rpx 0;
}

.selection-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0 22rpx;
}

.selection-grid .button {
  flex: 0 0 auto;
  min-width: 76rpx;
  padding-right: 14rpx;
  padding-left: 14rpx;
}

.action-link {
  display: block;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}
