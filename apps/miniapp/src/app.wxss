page {
  background: #f8f6f3;
  color: #272327;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 15px;
  line-height: 1.55;
  font-variant-numeric: tabular-nums;
}

.page-shell {
  box-sizing: border-box;
  max-width: 960rpx;
  margin: 0 auto;
  padding: 22px 16px calc(26px + env(safe-area-inset-bottom));
}

.page-title {
  display: block;
  margin: 0 0 19px;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -.65px;
}

.section-title {
  margin: 24px 0 10px;
  font-size: 17px;
  font-weight: 650;
  line-height: 1.4;
}

.muted {
  color: #66595c;
  font-size: 13px;
}

.accent {
  color: #761f32;
  font-weight: 650;
}

.button {
  box-sizing: border-box;
  min-height: 38px;
  margin: 0;
  padding: 8px 14px;
  border: 1rpx solid transparent;
  border-radius: 8px;
  background: #761f32;
  color: #fff;
  font-size: 14px;
  font-weight: 650;
  line-height: 1.45;
}

.button::after {
  border: 0;
}

.button.quiet {
  border-color: #d5c4c5;
  background: #fff;
  color: #761f32;
}

button.button[disabled] {
  background: #ede7e5;
  color: #6c6063;
}

.press {
  opacity: .83;
}

.field, .picker {
  box-sizing: border-box;
  min-height: 44px;
  padding: 9px 12px;
  border: 1rpx solid #d5c4c5;
  border-radius: 8px;
  background: #fff;
  color: #272327;
}

.field {
  height: 44px;
  padding: 0 12px;
  min-width: 0;
}

.picker {
  margin: 6px 0;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.picker-label {
  flex-shrink: 0;
  color: #66595c;
  font-size: 13px;
}

.picker-value {
  font-weight: 600;
  text-align: right;
  margin-left: auto;
  font-size: 14px;
}

.message {
  margin: 32rpx 0;
  padding: 24rpx 0;
  color: #66595c;
}

.message .button {
  margin-top: 16rpx;
}

.list-row {
  padding: 12px 14px;
  margin: 8px 0;
  border: 1px solid #ded5d3;
  border-radius: 9px;
  background: #fff;
}

.row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.row-name {
  font-weight: 650;
  font-size: 16px;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.row-action {
  margin-top: 24rpx;
}

.form-field {
  display: block;
  margin: 14px 0;
  font-size: 14px;
}

.form-field .field {
  margin-top: 5px;
}

.list-row > .muted, .list-row > .row-line + view {
  margin-top: 8rpx;
}

.form-error {
  margin: 24rpx 0;
  color: #761f32;
  overflow-wrap: anywhere;
}

.section-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 32rpx;
}

.section-actions .button {
  flex: 1 1 180rpx;
}

.subheading {
  margin: 16px 0 8px;
  font-size: 15px;
  font-weight: 650;
}

.details {
  margin: 8px 0;
  padding: 8px 10px;
  border-radius: 8px;
  background: #f0eae8;
  color: #524549;
  overflow-wrap: anywhere;
  font-size: 14px;
}

.filter-row {
  margin: 8px 0;
}

.selection-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0 22rpx;
}

.selection-grid .button {
  flex: 0 0 auto;
  min-width: 76rpx;
  padding-right: 14rpx;
  padding-left: 14rpx;
}

.action-link {
  display: block;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

/* A single class, booking, or availability window. */
.lesson-card {
  display: block;
  box-sizing: border-box;
  margin: 8px 0;
  padding: 12px 14px;
  border: 1rpx solid #ded5d3;
  border-radius: 9px;
  background: #fff;
  overflow-wrap: anywhere;
}

.lesson-card .card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
}

.card-title {
  font-size: 16px;
  font-weight: 650;
  line-height: 1.45;
  display: block;
}

.card-time {
  display: block;
  color: #761f32;
  font-size: 14px;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.training-plan {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.card-note, .card-state {
  color: #66595c;
  font-size: 13px;
  line-height: 1.55;
}

.card-state {
  flex-shrink: 0;
  font-weight: 600;
}

.card-head + .card-time, .card-head + .card-note, .card-time + .card-title {
  margin-top: 8rpx;
}

.card-footer {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1rpx solid #e6dfdc;
  font-size: 13px;
  color: #66595c;
}

.lesson-card .section-actions {
  margin-bottom: 0;
}

.card-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.card-fields .field {
  width: 100%;
}

.coach-face {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #f0e4e5;
  color: #761f32;
  font-size: 36rpx;
  font-weight: 650;
}

.coach-face image {
  display: block;
  width: 100%;
  height: 100%;
}

.utility-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0 32rpx;
  margin-top: 28rpx;
  color: #66595c;
  font-size: 13px;
  text-align: left;
  margin: 14px 0;
}

.utility-links > navigator { padding: 4px 0; }
.utility-links > text { padding: 12rpx 0; }

.page-shell.parent-tab-page {
  padding-bottom: calc(64px + env(safe-area-inset-bottom));
}

.message button.button, button.button.row-action {
  display: block;
  width: fit-content;
  max-width: 100%;
  margin-left: 0;
  margin-right: auto;
}

button.button.row-action.save-profile {
  margin-left: auto;
  margin-right: 0;
}

.section-actions.form-actions {
  justify-content: flex-end;
}

.section-actions.form-actions .button, .section-actions.item-actions .button {
  flex: 0 1 auto;
  width: auto;
  margin: 0;
}

.page-title + .section-title { margin-top: 0; }
.form-field > text { font-weight: 620; }
form > .form-field:first-child, .form-field.first-field, .lesson-card > .form-field:first-child { margin-top: 0; }
.lesson-card > .form-field:last-child { margin-bottom: 0; }
.chevron {
  content: "";
  flex: none;
  width: 6px;
  height: 6px;
  border: solid #9a878b;
  border-width: 1.5px 1.5px 0 0;
  transform: rotate(45deg);
}
.form-actions { margin: 18px 0 0; }
.item-actions { margin: 12px 0 0; }
.item-actions .button, .lesson-card .button.row-action, .list-row .button.row-action {
  min-height: 32px;
  padding: 5px 10px;
  font-size: 13px;
}
.screen-heading, .review-time-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.screen-heading { margin-bottom: 16px; min-height: 35px; }
.screen-heading .page-title { margin: 0; }
.screen-heading button.button { margin: 0; width: auto; min-height: 34px; font-size: 13px; padding: 7px 10px; }
.review-tabs { align-items: center; border-bottom: 1px solid #ded5d3; gap: 19px; margin: 12px 0; }
.review-tabs .button, .review-tabs .button.quiet {
  margin: 0;
  font-size: 14px;
  line-height: 1.45;
  width: auto;
  flex: none;
  border: 0;
  border-bottom: 2.5px solid #761f32;
  border-radius: 0;
  padding: 7px 0;
  background: transparent;
  color: #761f32;
}
.review-tabs .button.quiet { border-bottom-color: transparent; color: #66595c; font-weight: 500; }
.review-time-line { gap: 8px; margin-bottom: 3px; }
.review-time-line .card-time { margin: 0; }

.compact-switch { transform: scale(.78); transform-origin: right center; }
