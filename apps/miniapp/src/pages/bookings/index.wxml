<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">我的预约</text>
  <view wx:if="{{loading}}" class="message">正在查询预约…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重新查询</button>
  </view>
  <block wx:else>
    <view class="section-title" role="heading" aria-level="2">待确认和即将开课</view>
    <view wx:if="{{upcoming.length}}" class="muted">如需取消，请在开课前至少 6 小时联系场馆管理员。</view>
    <view wx:if="{{!upcoming.length}}" class="muted">暂无即将上课的预约，去排课页选择课程。</view>
    <view wx:for="{{upcoming}}" wx:key="id" class="list-row">
      <view class="row-line">
        <text class="row-name">{{item.title}}</text><text class="accent">{{item.label}}</text>
      </view>
      <view>{{item.hours}}</view>
      <view class="muted">{{item.coachName}}教练 · {{item.venue}} · {{item.points}} 积分</view>
    </view>

    <view class="section-title" role="heading" aria-level="2">历史预约</view>
    <view wx:if="{{!history.length}}" class="muted">暂无历史预约。</view>
    <view wx:for="{{history}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.title}}</text><text class="muted">{{item.label}}</text></view>
      <view>{{item.hours}}</view>
      <view class="muted">{{item.coachName}}教练 · {{item.venue}} · {{item.points}} 积分</view>
      <view wx:if="{{item.status === 'CANCELLED' && item.refundPoints > 0}}" class="muted">已退回 {{item.refundPoints}} 积分</view>
    </view>
  </block>
</view>
