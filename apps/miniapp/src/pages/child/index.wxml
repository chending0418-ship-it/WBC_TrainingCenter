<import src="../../registration/details.wxml" />
<view wx:if="{{authorized}}" class="page-shell enrollment">
  <view wx:if="{{loading}}" class="message">正在查询队员注册…</view>
  <view wx:elif="{{error}}" class="message">{{error}}<button class="button quiet" bindtap="refresh">重新查询</button></view>
  <form wx:elif="{{editing}}" bindsubmit="save">
    <view wx:if="{{registration && registration.status !== 'APPROVED'}}" class="en-back" bindtap="back" role="button">注册申请</view>
    <view wx:elif="{{!registration}}" class="en-back" bindtap="continueBrowsing" role="button">返回课表</view>
    <text class="page-title" role="heading" aria-level="1">{{registration && registration.status === 'APPROVED' ? '队员资料' : '注册队员'}}</text>
    <block wx:if="{{!registration || registration.status !== 'APPROVED'}}">
      <view class="en-hint">填写队员资料，提交给场馆审核。</view>
      <view class="en-sub">队员资料</view>
    </block>
    <label class="form-field"><text>{{registration && registration.status === 'APPROVED' ? '姓名或昵称' : '队员姓名或昵称'}}</text>
      <input class="field en-input" value="{{name}}" data-field="name" bindinput="changeField" maxlength="40" disabled="{{saving}}" placeholder="请输入姓名或昵称" />
    </label>
    <view class="{{registration && registration.status === 'APPROVED' ? '' : 'registration-pickers'}}">
    <picker mode="date" fields="month" start="1900-01" end="{{maxMonth}}" value="{{birthMonth || maxMonth}}" bindchange="changeMonth" disabled="{{saving}}">
      <view class="picker"><text class="picker-label">出生年月</text><text class="picker-value">{{birthMonth || '请选择'}}</text></view>
    </picker>
    <picker range="{{genders}}" range-key="label" value="{{genderIndex < 0 ? 0 : genderIndex}}" bindchange="changeGender" disabled="{{saving}}">
      <view class="picker"><text class="picker-label">性别</text><text class="picker-value">{{genderIndex < 0 ? '请选择' : genders[genderIndex].label}}</text></view>
    </picker>
    </view>
    <block wx:if="{{!registration || registration.status !== 'APPROVED'}}">
      <view class="en-sub">联系人（选填）</view>
      <label class="form-field"><text>联系人姓名</text><input class="field" value="{{contactName}}" data-field="contactName" bindinput="changeField" maxlength="40" disabled="{{saving}}" /></label>
      <label class="form-field"><text>联系电话</text><input class="field" value="{{phone}}" data-field="phone" bindinput="changeField" maxlength="24" disabled="{{saving}}" /></label>
    </block>
    <view wx:if="{{saveError}}" class="form-error" aria-live="polite">{{saveError}}</view>
    <view class="en-actions"><button class="button" form-type="submit" loading="{{saving}}" disabled="{{saving}}">{{registration && registration.status === 'APPROVED' ? '保存资料' : '提交注册申请'}}</button></view>
  </form>
  <block wx:elif="{{registration}}">
    <text class="page-title" role="heading" aria-level="1">队员注册</text>
    <view class="en-state">
      <view class="en-state-title">{{registration.status === 'PENDING' ? '等待管理员审核' : (registration.status === 'RETURNED' ? '请补充资料' : '注册已通过')}}</view>
      <view class="en-state-note">{{registration.status === 'PENDING' ? '申请已提交。审核结果可在「我的账户」查看。' : (registration.status === 'RETURNED' ? registration.reason : registration.child.name + '已取得团课和私教的预约资格。')}}</view>
    </view>
    <block wx:if="{{registration.status === 'PENDING'}}">
      <view class="en-sub">本次申请</view>
      <view class="en-summary">
        <view class="en-meta"><text>队员</text><text>{{registration.child.name}}</text></view>
        <view class="en-meta"><text>提交时间</text><text>{{registration.submittedLabel}}</text></view>
      </view>
      <view class="en-hint">审核通过后，即可申请团课和私教。</view>
    </block>
    <block wx:else>
      <view class="en-heading"><text>{{registration.status === 'RETURNED' ? '申请资料' : '队员资料'}}</text><text wx:if="{{registration.status === 'APPROVED'}}" class="en-link" bindtap="edit" role="button">编辑</text></view>
      <template is="registrationDetails" data="{{row: registration}}" />
      <block wx:if="{{registration.status === 'APPROVED' && reminder}}">
        <view class="en-sub">上次查看的课程</view>
        <view class="en-course"><text class="en-course-title">{{reminder.title}}</text><text class="en-person-note">{{reminder.when}}</text></view>
      </block>
    </block>
    <view class="en-actions">
      <button wx:if="{{registration.status === 'RETURNED'}}" class="button" bindtap="edit">修改并重新提交</button>
      <button wx:else class="button {{registration.status === 'PENDING' ? 'quiet' : ''}}" bindtap="continueBrowsing">{{registration.status === 'APPROVED' && reminder ? '返回课程查看余位' : '继续看课'}}</button>
    </view>
  </block>
</view>
