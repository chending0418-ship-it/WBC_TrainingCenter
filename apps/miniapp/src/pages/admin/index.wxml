<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">俱乐部管理员</text>
  <view class="overview">
    <view class="overview-today">
      <text class="overview-label">今日训练</text>
      <view wx:if="{{overview}}" class="today-counts"><view>{{overview.todayClasses}} 个团课班次</view><view>{{overview.todayAppointments}} 笔已确认预约</view></view>
      <text wx:else class="today-counts">{{error ? '暂无统计数据' : '正在加载统计…'}}</text>
    </view>
    <navigator class="pending" url="/pages/admin-bookings/index?pending=1" hover-class="press">
      <view class="overview-label">待确认预约<text class="arrow" aria-hidden="true"></text></view>
      <text class="pending-number">{{overview ? overview.pending : '—'}}</text>
    </navigator>
  </view>
  <view wx:if="{{error}}" class="message">
    <view>统计更新失败。{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重试</button>
  </view>
  <navigator class="registration-shortcut" url="/pages/admin-registrations/index" hover-class="press">
    <text>队员注册审核</text><text class="registration-pending">{{overview ? overview.pendingRegistrations + ' 个待审核' : '查看'}}</text><view class="chevron" aria-hidden="true"></view>
  </navigator>
  <view class="shortcuts">
    <navigator wx:for="{{shortcuts}}" wx:key="page" class="shortcut" url="/pages/{{item.page}}/index" hover-class="press">
      <image class="shortcut-icon" src="/pages/admin/icons/{{item.icon}}.svg" mode="aspectFit" aria-hidden="true"/>
      <text class="shortcut-label">{{item.label}}</text>
    </navigator>
  </view>
  <subscription-reminder topic="admin" />
  <view class="utility-links">
    <navigator url="/pages/agreements/index" hover-class="press">使用协议与隐私说明</navigator>
    <text aria-role="button" bindtap="switchRole" hover-class="press">切换角色</text>
  </view>
</view>
