<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">管理端</text>
  <view wx:if="{{loading}}" class="message">正在验证管理员会话…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重试</button>
  </view>
  <block wx:else>
    <navigator class="action-link" url="/pages/admin-schedule/index" hover-class="press">
      <view class="row-name">排课管理</view>
      <view class="muted">安排团课，维护私教开放时间</view>
    </navigator>
    <navigator class="action-link" url="/pages/admin-course-types/index" hover-class="press">
      <view class="row-name">课程类型</view>
      <view class="muted">设置人数上限和取消退还比例</view>
    </navigator>
    <navigator class="action-link" url="/pages/admin-bookings/index" hover-class="press">
      <view class="row-name">预约管理</view>
      <view class="muted">查看、代约和取消</view>
    </navigator>
    <navigator class="action-link" url="/pages/admin-points/index" hover-class="press">
      <view class="row-name">积分管理</view>
      <view class="muted">线下入账、人工调整和冲正</view>
    </navigator>
  </block>
  <button class="button quiet row-action" bindtap="signOut" hover-class="press">退出管理员登录</button>
</view>
