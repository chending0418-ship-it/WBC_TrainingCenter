.overview {
  display: flex;
  align-items: stretch;
  padding: 28rpx 0;
  border-radius: 20rpx;
  background: #671d30;
  color: #fff;
}

.overview-today, .pending {
  box-sizing: border-box;
  flex: 1;
  padding: 0 28rpx;
}

.pending {
  border-left: 1px solid #98566a;
}

.overview-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 650;
}

.today-counts {
  display: block;
  margin-top: 8rpx;
  color: #f8e9ec;
  font-size: 24rpx;
  line-height: 1.55;
}

.pending-number {
  display: block;
  margin-top: 4rpx;
  font-size: 52rpx;
  line-height: 1.35;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  transform: rotate(45deg);
}

.shortcuts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 24rpx 0 36rpx;
  border: 1rpx solid #ded5d3;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
}

.shortcut {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 156rpx;
  padding: 20rpx 4rpx;
  text-align: center;
}

.shortcut:nth-child(n+4) {
  border-top: 1rpx solid #e9e2df;
}

.shortcut:not(:nth-child(3n)) {
  border-right: 1rpx solid #e9e2df;
}

.shortcut-icon {
  width: 52rpx;
  height: 52rpx;
}

.shortcut-label {
  font-size: 28rpx;
  font-weight: 600;
}

.utility-links {
  justify-content: space-between;
}

.registration-shortcut { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding: 12px 14px; background: white; border: 1px solid #ded5d3; border-radius: 10px; font-weight: 650; }
.registration-shortcut .chevron { margin-left: 8px; }
.registration-pending { margin-left: auto; color: #761f32; font-size: 14px; font-weight: 500; }
