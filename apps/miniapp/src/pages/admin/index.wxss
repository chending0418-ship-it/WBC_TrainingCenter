.overview {
  display: flex;
  align-items: stretch;
  padding: 3.7333vw 0;
  border-radius: 2.6667vw;
  background: #671d30;
  color: #fff;
}

.week-heading, .week-controls, .week-lesson { display: flex; align-items: center; }
.week-heading { flex-wrap: wrap; justify-content: space-between; gap: 4px; margin-bottom: 8px; }
.week-range { font-size: 17px; font-weight: 650; }
.week-controls button, button.agenda-toggle {
  display: flex; align-items: center; justify-content: center;
  width: auto; min-width: 44px; min-height: 44px; padding: 0 5px; margin: 0;
  color: #761f32; background: transparent; font-size: 14px; line-height: 1.4;
}
.week-controls button::after, .agenda-toggle::after { border: 0; }
.week-controls .week-step { font-size: 23px; }
.week-controls button[disabled] { color: #66595c; }
.metric { flex: 1; padding-left: 14px; border-left: 1px solid #99596a; }
.metric:first-child { border: 0; }
.metric text { display: block; font-size: 13px; }
.metric text + text { margin-top: 3px; font-size: 25px; font-weight: 700; }
button.agenda-toggle { width: 100%; justify-content: space-between; padding: 8px 0; }
.agenda-toggle text:first-child, .week-day { color: #272327; font-weight: 650; }
.week-agenda { padding-bottom: 8px; }
.week-day { margin: 8px 0 4px; }
.week-lesson { gap: 12px; align-items: baseline; padding: 5px 0; border-bottom: 1px solid #e9e2df; }
.week-lesson > text { flex-shrink: 0; }
.week-empty { padding: 12px 0 0; color: #66595c; }
.shortcuts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 3.2vw 0 4.8vw;
  border: 1rpx solid #ded5d3;
  border-radius: 2.6667vw;
  overflow: hidden;
  background: #fff;
}

.shortcut {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.8667vw;
  min-height: 20.8vw;
  padding: 2.6667vw 0.5333vw;
  text-align: center;
}

.shortcut:nth-child(n+4) {
  border-top: 1rpx solid #e9e2df;
}

.shortcut:not(:nth-child(3n)) {
  border-right: 1rpx solid #e9e2df;
}

.shortcut-icon {
  width: 6.9333vw;
  height: 6.9333vw;
}

.shortcut-label {
  font-size: 3.7333vw;
  font-weight: 600;
}

.utility-links {
  justify-content: space-between;
}

.registration-shortcut { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding: 12px 14px; background: white; border: 1px solid #ded5d3; border-radius: 10px; font-weight: 650; }
.registration-shortcut .chevron { margin-left: 8px; }
.registration-pending { margin-left: auto; color: #761f32; font-size: 14px; font-weight: 500; }

.shortcut { min-height: 76px; }
.shortcut-label { font-size: 14px; }
