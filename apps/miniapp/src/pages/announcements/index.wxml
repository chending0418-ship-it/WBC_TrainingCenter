<view class="page-shell">
 <text class="page-title">{{selected ? '公告详情' : '俱乐部公告'}}</text>
 <view wx:if="{{error}}" class="message">{{error}}<button class="button quiet" bindtap="retry">重新加载</button></view>
 <block wx:if="{{selected}}"><view class="section-title">{{selected.title}}</view><view class="muted">{{selected.date}} 发布</view><view class="notice-body">{{selected.body}}</view>
 <view class="actions"><button wx:if="{{!selected.isRead}}" class="button" bindtap="mark" disabled="{{busy}}">标为已读</button><button class="button quiet" bindtap="close">返回公告栏</button></view></block>
 <block wx:else><view wx:if="{{!loaded && !error}}" class="message">正在读取公告…</view><view wx:if="{{loaded && !rows.length}}" class="message">暂无俱乐部公告</view>
 <button wx:for="{{rows}}" wx:key="id" class="notice-row" bindtap="select" data-id="{{item.id}}"><view class="meta"><text>{{item.date}}</text><text>{{item.isRead ? '已读' : '● 未读'}}</text></view><text class="row-name">{{item.title}}</text></button>
 <button wx:if="{{next}}" class="button quiet" bindtap="more" disabled="{{busy}}">更早公告</button></block>
</view>
