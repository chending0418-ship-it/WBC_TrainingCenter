.page-shell.announcement-page {
  padding: 16px 4vw calc(26px + env(safe-area-inset-bottom));
}
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.notice-list > button.notice-row {
  display: block;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 14px 16px;
  border: 1px solid #ded4d2;
  border-radius: 8px;
  background: #fff;
  color: #272327;
  text-align: left;
  white-space: normal;
}
.notice-row::after { border: 0; }
.notice-row .row-name, .notice-heading, .notice-body { overflow-wrap: anywhere; word-break: break-word; }
.notice-meta, .notice-state, .notice-actions { display: flex; align-items: center; }
.notice-meta {
  justify-content: space-between;
  gap: 10px;
  margin-top: 6px;
  color: #66595c;
  font-size: 13px;
  font-weight: 400;
  line-height: 1.5;
}
.notice-state { flex-shrink: 0; gap: 5px; }
.notice-state.unread { color: #761f32; font-weight: 600; }
.unread-dot { width: 7px; height: 7px; border-radius: 50%; background: #a02c43; }
.notice-heading { margin-bottom: 6px; font-size: 22px; font-weight: 650; line-height: 1.4; }
.notice-body { margin: 18px 0; white-space: pre-wrap; }
.notice-actions { flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
.announcement-page button.button { width: auto; min-height: 44px; margin: 0; }
.announcement-page button.more { display: block; margin: 12px 0 0 auto; }
