.notice-row { display:block; width:100%; text-align:left; padding:12px 14px; margin:9px 0; background:white; border:1px solid #ded4d2; border-radius:8px; line-height:1.55; }
.notice-row::after { border:0; }
.meta,.actions { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.meta { font-size:12px; color:#66595c; } .meta text:last-child { color:#761f32; }
.notice-body { margin:18px 0; white-space:pre-wrap; overflow-wrap:anywhere; }
.actions { justify-content:flex-start; }
