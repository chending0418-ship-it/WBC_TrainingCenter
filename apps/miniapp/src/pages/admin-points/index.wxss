.page-shell > .details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 15px;
  background: #761f32;
  color: white;
}
.page-shell > .details .accent { color: white; font-size: 23px; }
form .section-actions:not(.form-actions) { margin: 5px 0 12px; }
form .section-actions:not(.form-actions) .button { flex: none; min-width: 70px; min-height: 32px; padding: 5px 12px; }
.undo-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  padding: 18px;
  background: rgba(30, 23, 25, .45);
}
.undo-panel { box-sizing: border-box; width: 100%; max-width: 400px; max-height: 90vh; overflow-y: auto; padding: 18px; border-radius: 12px; background: white; }
.undo-title { font-size: 20px; font-weight: 650; margin-bottom: 12px; }
.undo-record { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 4px 8px; padding: 12px; background: #f8f6f3; border-radius: 8px; font-size: 14px; }
.undo-record .muted { grid-column: 1/-1; font-size: 12px; }
.undo-note { margin: 14px 0; font-size: 14px; }
.undo-actions { display: grid; grid-template-columns: 1fr 2fr; gap: 8px; margin-top: 16px; }
.undo-actions button { width: 100%; }
