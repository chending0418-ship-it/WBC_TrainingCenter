<page-meta page-style="{{original ? 'overflow:hidden' : ''}}" />
<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">积分调整</text>
  <view class="points-selector">
    <view class="points-account"><text class="points-label">队员账户</text><text wx:if="{{users.length}}" class="row-name">{{users[0].label}}</text></view>
    <button class="button quiet" bindtap="pickPlayer" disabled="{{busy || original}}" hover-class="press">{{users.length ? '更换队员' : '选择队员'}}</button>
  </view>
  <view wx:if="{{loading}}" class="message">正在查询积分账户…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view><button class="button quiet" bindtap="load" hover-class="press">重新查询</button>
  </view>
  <block wx:elif="{{users.length}}">
    <view class="details">当前可用积分 <text class="accent">{{balance}}</text></view>
    <view wx:if="{{reservedPoints}}" class="muted">待确认预约预留 {{reservedPoints}} 积分</view>
    <view class="review-tabs points-tabs">
      <button size="mini" class="button {{source === 'OFFLINE_CREDIT' ? '' : 'quiet'}}" data-source="OFFLINE_CREDIT"
        bindtap="setMode" disabled="{{busy}}" aria-pressed="{{source === 'OFFLINE_CREDIT'}}" hover-class="press">充值</button>
      <button size="mini" class="button {{source === 'ADJUSTMENT' ? '' : 'quiet'}}" data-source="ADJUSTMENT"
        bindtap="setMode" disabled="{{busy}}" aria-pressed="{{source === 'ADJUSTMENT'}}" hover-class="press">调整</button>
    </view>
    <form bindsubmit="save">
      <view wx:if="{{source === 'ADJUSTMENT'}}">
        <view class="subheading">调整方向</view>
        <view class="direction-options" aria-role="group" aria-label="调整方向">
          <button size="mini" class="button direction-option {{direction === 1 ? '' : 'quiet'}}" data-direction="1" bindtap="setDirection"
            disabled="{{busy}}" aria-pressed="{{direction === 1}}" hover-class="press">增加</button>
          <button size="mini" class="button direction-option {{direction === -1 ? '' : 'quiet'}}" data-direction="-1" bindtap="setDirection"
            disabled="{{busy}}" aria-pressed="{{direction === -1}}" hover-class="press">扣减</button>
        </view>
      </view>
      <label class="form-field">
        <text>{{source === 'OFFLINE_CREDIT' ? '充值积分' : '调整积分'}}</text>
        <input class="field" type="number" maxlength="6" placeholder="例如 100" value="{{points}}" data-field="points" bindinput="changeField" disabled="{{busy}}" />
      </label>
      <picker wx:if="{{source === 'ADJUSTMENT' && direction === -1}}" range="{{training}}" range-key="label" value="{{trainingIndex}}" bindchange="selectTraining" disabled="{{busy}}">
        <view class="picker"><text class="picker-label">关联历史训练（选填）</text><text class="picker-value">{{training[trainingIndex].label}}</text></view>
      </picker>
      <button wx:if="{{source === 'ADJUSTMENT' && direction === -1 && choiceNext.training !== null}}" class="button quiet row-action" size="mini"
        bindtap="loadChoices" data-field="training" loading="{{choiceBusy.training}}" disabled="{{busy || choiceBusy.training}}">{{choiceNext.training ? '加载更早的历史训练' : '查询可关联历史训练'}}</button>
      <picker wx:if="{{source === 'ADJUSTMENT'}}" range="{{bookings}}" range-key="label" value="{{bookingIndex}}" bindchange="selectBooking" disabled="{{busy}}">
        <view class="picker"><text class="picker-label">关联预约</text><text class="picker-value">{{bookings[bookingIndex].label}}</text><view class="chevron" aria-hidden="true"></view></view>
      </picker>
      <button wx:if="{{source === 'ADJUSTMENT' && choiceNext.bookings !== null}}" class="button quiet row-action" size="mini"
        bindtap="loadChoices" data-field="bookings" loading="{{choiceBusy.bookings}}" disabled="{{busy || choiceBusy.bookings}}">{{choiceNext.bookings ? '加载更早的预约' : '查询可关联预约'}}</button>
      <label class="form-field">
        <text>{{source === 'OFFLINE_CREDIT' ? '充值备注' : '调整原因'}}</text>
        <input class="field" maxlength="100" placeholder="{{source === 'OFFLINE_CREDIT' ? '例如 线下收款' : '填写原因'}}" value="{{reason}}" data-field="reason" bindinput="changeField" disabled="{{busy}}" />
      </label>
      <label wx:if="{{source === 'ADJUSTMENT'}}" class="form-field">
        <text>备注（选填）</text>
        <input class="field" maxlength="100" placeholder="例如 DEMO-001" value="{{reference}}" data-field="reference" bindinput="changeField" disabled="{{busy}}" />
      </label>
      <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
      <view class="section-actions form-actions">
        <button class="button" form-type="submit" loading="{{busy}}" disabled="{{busy}}" hover-class="press">{{action}}</button>
      </view>
    </form>
    <view class="section-title" role="heading" aria-level="2">积分流水</view>
    <view wx:if="{{!ledger.length}}" class="message">该账户暂无积分流水。</view>
    <view wx:for="{{ledger}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.reason}}</text><text class="accent">{{item.deltaLabel}}</text></view>
      <view class="muted">{{item.dateLabel}}{{item.operator ? ' · ' + item.operator : ''}}</view>
      <view wx:if="{{item.reference}}" class="muted">{{item.reference}}</view>
      <view wx:if="{{item.trainingLabel}}" class="muted">关联训练 {{item.trainingLabel}}</view>
      <view wx:if="{{item.bookingLabel}}" class="muted">关联预约 {{item.bookingLabel}}</view>
      <view wx:if="{{item.reversalId}}" class="muted">已撤销 · 流水 #{{item.reversalId}}</view>
      <view wx:if="{{item.reversalOf}}" class="muted">原流水 #{{item.reversalOf}}</view>
      <button wx:if="{{item.canReverse}}" class="button quiet row-action" bindtap="startReversal" data-id="{{item.id}}"
        disabled="{{busy}}" aria-label="撤销流水 {{item.id}}" hover-class="press">撤销这笔记录</button>
    </view>
    <button wx:if="{{nextBefore}}" class="button quiet" bindtap="loadMore">更早的流水</button>
  </block>
  <view wx:if="{{original}}" class="undo-overlay">
    <form class="undo-panel" bindsubmit="reverse" aria-role="dialog" aria-label="撤销这笔记录">
      <view class="undo-title">撤销这笔记录？</view>
      <view class="undo-record">
        <text>{{users[userIndex].label}} · {{original.reason}}</text>
        <text class="accent">{{original.deltaLabel}} 积分</text>
        <text class="muted">{{original.dateLabel}} · 流水 #{{original.id}}</text>
      </view>
      <view class="undo-note">撤销后，可用积分将从 <text class="row-name">{{balance}}</text> 变为 <text class="row-name">{{balance - original.delta}}</text>。</view>
      <label class="form-field"><text>撤销原因</text>
        <input class="field" value="{{reversalReason}}" bindinput="changeReversalReason" maxlength="100" disabled="{{busy}}" placeholder="填写撤销原因" />
      </label>
      <view wx:if="{{reversalError}}" class="form-error">{{reversalError}}</view>
      <view class="undo-actions"><button class="button quiet" bindtap="closeReversal" disabled="{{busy}}" hover-class="press">返回</button>
        <button class="button" form-type="submit" disabled="{{busy || !reversalReason}}" loading="{{busy}}" hover-class="press">确认撤销</button></view>
    </form>
  </view>
</view>
