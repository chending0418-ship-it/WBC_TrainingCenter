<view wx:if="{{authorized}}" class="page-shell parent-tab-page">
  <text class="page-title" role="heading" aria-level="1">我的账户</text>
  <navigator class="picker" url="/pages/family/index" hover-class="press"><text>{{playerName || '我的队员'}}</text><text class="accent">管理与切换队员</text></navigator>
  <view class="utility-links">当前角色 · 队员家长<button wx:if="{{canSwitch}}" size="mini" bindtap="switchRole">切换角色</button></view>
  <view wx:if="{{loading}}" class="message">正在查询账户…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重新查询</button>
  </view>
  <block wx:if="{{loaded}}">
    <view class="balance">
      <view>可用积分</view>
      <text class="balance-number">{{balance}}</text>
      <view wx:if="{{reservedPoints}}">{{reservedPoints}} 积分为待确认预约预留</view>
    </view>
    <navigator class="picker profile" url="{{playerName ? '/pages/child/index' : '/pages/family/index'}}" hover-class="press">
      <text>队员注册</text><text class="accent">{{registrationLabel}}</text>
    </navigator>
    <navigator class="picker profile" url="/pages/contact/index" hover-class="press">
      <text>联系人资料</text><text class="accent">查看与编辑</text>
    </navigator>
  </block>
  <view class="utility-links">
    <text aria-role="button" bindtap="copyAccountId" hover-class="press">复制账号 ID</text>
    <navigator url="/pages/agreements/index" hover-class="press">使用协议与隐私说明</navigator>
  </view>
  <block wx:if="{{loaded}}">
    <view class="section-title" role="heading" aria-level="2">积分流水</view>
    <view wx:if="{{!ledger.length}}" class="muted">暂无积分变动。</view>
    <view wx:for="{{ledger}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.reason}}</text><text class="accent">{{item.change}}</text></view>
      <view class="muted">{{item.date}}</view><view wx:if="{{item.training}}" class="muted">关联训练 {{item.training}}</view>
    </view>
    <button wx:if="{{nextBefore}}" class="button quiet" bindtap="loadMore" disabled="{{moreBusy}}">更早的流水</button>
  </block>
</view>
