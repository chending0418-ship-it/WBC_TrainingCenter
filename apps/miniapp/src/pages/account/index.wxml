<view wx:if="{{authorized}}" class="page-shell parent-tab-page account-page">
  <view class="account-heading">
    <text class="page-title" role="heading" aria-level="1">我的账户</text>
  </view>
  <view class="account-heading account-section">
    <text class="section-title" role="heading" aria-level="2">队员积分</text>
    <navigator class="account-action" url="/pages/family/index" hover-class="press">管理队员</navigator>
  </view>
  <view wx:if="{{error}}" class="message"><text>{{error}}</text><button class="button quiet" bindtap="refresh">重新查询</button></view>
  <view wx:elif="{{!loaded}}" class="muted account-empty">正在查询积分…</view>
  <view wx:elif="{{!wallets.length}}" class="account-panel account-empty">暂无队员积分。可在「管理队员」创建或关联队员。</view>
  <view wx:else class="account-panel">
    <view wx:for="{{wallets}}" wx:key="id" class="account-row wallet-row" data-id="{{item.id}}" bindtap="openWallet" aria-role="button" hover-class="press">
      <view class="account-primary"><text class="wallet-name">{{item.title}}</text><text wx:if="{{item.jerseyNumber}}" class="jersey">#{{item.jerseyNumber}}</text></view>
      <view class="wallet-value"><text class="wallet-number">{{item.available}}</text><text class="wallet-caption">可用积分</text></view>
      <view class="account-chevron"></view>
    </view>
  </view>
  <view class="account-heading account-section"><text class="section-title" role="heading" aria-level="2">账户资料</text></view>
  <view class="account-panel">
    <navigator class="account-row" url="/pages/contact/index" hover-class="press"><text class="account-primary">联系人资料</text><text class="row-link">编辑</text><view class="account-chevron"></view></navigator>
    <view class="account-row" bindtap="copyAccountId" aria-role="button" hover-class="press"><text class="account-primary">家长账号 ID</text><text class="row-link">复制</text><view class="account-chevron"></view></view>
    <navigator class="account-row" url="/pages/agreements/index" hover-class="press"><text class="account-primary">使用协议与隐私说明</text><text class="row-link">查看</text><view class="account-chevron"></view></navigator>
  </view>
  <view wx:if="{{canEnterAdmin || canEnterCoach}}" class="account-role-actions">
    <button wx:if="{{canEnterAdmin}}" class="button quiet role-entry" data-role="ADMIN" disabled="{{enteringRole}}" bindtap="enterRole" hover-class="press">进入管理端</button>
    <button wx:if="{{canEnterCoach}}" class="button quiet role-entry" data-role="COACH" disabled="{{enteringRole}}" bindtap="enterRole" hover-class="press">进入教练端</button>
  </view>
</view>
