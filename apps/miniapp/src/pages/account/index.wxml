<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">我的账户</text>
  <view wx:if="{{loading}}" class="message">正在查询账户…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重新查询</button>
  </view>
  <block wx:else>
    <view class="balance">
      <view>可用积分</view>
      <text class="balance-number">{{balance}}</text>
      <view wx:if="{{reservedPoints}}">{{reservedPoints}} 积分为待确认预约预留</view>
    </view>
    <navigator class="picker profile" url="/pages/child/index" hover-class="press">
      <text>孩子资料</text><text class="accent">{{childName ? childName + ' · 编辑' : '填写资料'}}</text>
    </navigator>
    <navigator class="picker profile" url="/pages/contact/index" hover-class="press">
      <text>联系人资料</text><text class="accent">查看与编辑</text>
    </navigator>
    <navigator class="picker profile" url="/pages/agreements/index" hover-class="press">
      <text>使用协议与隐私说明</text><text class="accent">查看</text>
    </navigator>
  </block>
  <button wx:if="{{switchable}}" class="button quiet row-action" bindtap="switchRole" hover-class="press">切换身份</button>
  <button class="button quiet logout-button" bindtap="signOut" hover-class="press">退出家长登录</button>

  <block wx:if="{{!loading && !error}}">
    <view class="section-title" role="heading" aria-level="2">积分流水</view>
    <view wx:if="{{!ledger.length}}" class="muted">暂无积分变动。</view>
    <view wx:for="{{ledger}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.reason}}</text><text class="accent">{{item.change}}</text></view>
      <view class="muted">{{item.date}}</view>
    </view>
  </block>
</view>
