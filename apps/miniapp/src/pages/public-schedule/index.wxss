@import "../../calendar/week.wxss";
@import "../../registration/dialog.wxss";
.calendar-heading.public-heading { min-height: 0; }
.public-heading .login-link {
  width: auto;
  min-height: 32px;
  margin: 0;
  padding: 0 0 0 10px;
  background: transparent;
  color: #761f32;
  font-size: 14px;
  font-weight: 400;
  line-height: 32px;
}
.login-link::after { border: 0; }

.agenda-card.public-course {
  display: block; width: 100%; margin-left: 0; margin-right: 0;
  text-align: left; color: inherit; font-size: inherit; font-weight: inherit; line-height: inherit;
}
.public-course::after { border: 0; }
.public-course .public-actions { justify-content: flex-end; }
