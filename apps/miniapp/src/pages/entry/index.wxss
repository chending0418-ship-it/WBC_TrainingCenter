.entry-actions {
  display: grid;
  gap: 10px;
  margin-top: 30rpx;
}

.entry-actions .button {
  width: 100%;
  min-height: 44px;
  margin: 0;
}

.entry-actions .entry-back {
  margin-top: 14rpx;
}

.entry-actions .role-choice {
  text-align: center;
}


.portal { display: flex; flex-direction: column; min-height: 100vh; background: #fbf8f3; }
.portal-hero { flex: 1 0 auto; position: relative; overflow: hidden; min-height: clamp(330px, 61vh, 660px); background: #521923; }
.portal-photo { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.portal-title { position: relative; padding: clamp(24px, 5vh, 45px) clamp(23px, 6.5vw, 34px); color: #fff7e9; font-weight: 700; }
.portal-title text { display: block; font-size: clamp(34px, 10.6vw, 50px); line-height: 1.1; letter-spacing: .015em; }
.portal-title text:first-child { font: 800 clamp(72px, 21vw, 108px)/.94 "Helvetica Neue", Arial, sans-serif; letter-spacing: -.045em; margin-bottom: 12px; }
.portal-actions { display: grid; gap: 2px; padding: 24px 26px 14px; }
.portal-actions button { width: 100%; }
.portal-actions .button { min-height: 50px; padding: 8px 16px; border-radius: 8px; font-size: 17px; letter-spacing: .035em; }
.browse-link { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 0; color: #761f32; background: transparent; font-size: 15px; font-weight: 600; }
.browse-link::after { border: 0; }
.browse-chevron { width: 7px; height: 7px; border: solid currentColor; border-width: 1.5px 1.5px 0 0; transform: rotate(45deg); }
.portal-signature { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 26px; padding: 19px 0 max(17px, env(safe-area-inset-bottom)); border-top: 1px solid #d9d1c9; color: #514950; font: 12px/1.4 Arial, sans-serif; }
.portal-signature image { width: 42px; height: 24px; flex: none; }
