<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">家长资料</text>
  <form bindsubmit="search">
    <label class="form-field">
      <text>搜索家长账户</text>
      <input class="field" value="{{query}}" bindinput="changeQuery" maxlength="50" placeholder="孩子姓名、联系人或电话" disabled="{{loading}}" />
    </label>
    <button class="button row-action" form-type="submit" disabled="{{loading}}" hover-class="press">搜索</button>
  </form>
  <view wx:if="{{loading}}" class="message">正在查询家长资料…</view>
  <view wx:elif="{{error}}" class="form-error">{{error}}</view>
  <view wx:elif="{{!parents.length}}" class="message">没有找到对应的家长账户。</view>
  <block wx:else>
    <view class="section-title" role="heading" aria-level="2">{{searched ? '搜索结果' : '家长账户'}}</view>
    <view wx:if="{{parents.length === 50}}" class="muted">最多显示 50 条结果，可输入更具体的关键词。</view>
    <view wx:for="{{parents}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.childName || '未填写孩子资料'}}</text><text class="accent">{{item.balance}} 积分</text></view>
      <view wx:if="{{item.child.birthMonth}}" class="muted">出生年月 {{item.child.birthMonth}} · {{item.child.gender === 'MALE' ? '男' : '女'}}</view>
      <view wx:if="{{item.contact}}">{{item.contact.name}} · {{item.contact.phone}}</view>
      <view wx:else class="muted">未填写联系人。</view>
      <view class="utility-links">
        <navigator url="/pages/admin-points/index?userId={{item.id}}&mode=credit" hover-class="press" aria-label="给{{item.childName || '该家庭'}}增加积分">增加积分</navigator>
        <navigator url="/pages/admin-points/index?userId={{item.id}}&mode=adjust" hover-class="press" aria-label="调整{{item.childName || '该家庭'}}的积分">调整积分</navigator>
      </view>
    </view>
  </block>
</view>
