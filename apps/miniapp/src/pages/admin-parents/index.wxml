<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">队员档案</text>
  <form bindsubmit="search">
    <view class="parent-search">
      <label class="form-field">
        <text>搜索账户</text>
        <input class="field" value="{{query}}" bindinput="changeQuery" maxlength="50" placeholder="姓名、球衣号码、电话或账户 ID" disabled="{{loading}}" />
      </label>
      <button class="button row-action" form-type="submit" disabled="{{loading}}" hover-class="press">搜索</button>
    </view>
  </form>
  <picker class="filter-row" range="{{filters}}" range-key="label" value="{{filterIndex}}" bindchange="changeFilter">
    <view class="picker"><text class="picker-label">档案筛选</text><text class="picker-value">{{filters[filterIndex].label}}</text><view class="chevron" aria-hidden="true"></view></view>
  </picker>
  <view wx:if="{{loading}}" class="message">正在查询队员档案…</view>
  <view wx:elif="{{error}}" class="form-error">{{error}}</view>
  <view wx:elif="{{!parents.length}}" class="message">{{filterIndex === 1 ? '没有符合条件的账户。' : '没有符合条件的队员。'}}</view>
  <block wx:else>
    <view class="section-title" role="heading" aria-level="2">{{searched ? '搜索结果' : filterIndex === 1 ? '未提交资料的账户' : '队员名单'}}</view>
    <view wx:if="{{parents.length === 50}}" class="muted">最多显示 50 条结果，可输入更具体的关键词。</view>
    <view wx:for="{{parents}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.childName || '未提交队员资料'}}{{item.jerseyNumber ? ' · #' + item.jerseyNumber : ''}}</text><text class="accent">{{item.balance}} 积分</text></view>
      <view wx:if="{{item.child.birthMonth}}" class="muted">出生年月 {{item.child.birthMonth}} · {{item.child.gender === 'MALE' ? '男' : '女'}}</view>
      <view wx:if="{{item.contact}}">{{item.contact.name}} · {{item.contact.phone}}</view>
      <view wx:if="{{item.child}}" class="admin-row-actions">
        <navigator class="button quiet" url="/pages/admin-player-edit/index?id={{item.id}}" hover-class="press">编辑资料</navigator>
        <navigator class="button quiet" url="/pages/admin-points/index?userId={{item.id}}&mode=adjust" hover-class="press">调整积分</navigator>
      </view>
    </view>
  </block>
</view>
