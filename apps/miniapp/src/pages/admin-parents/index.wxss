.parent-search { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: end; }
.parent-search .form-field, .parent-search button.row-action { margin: 0; }
.parent-search button.row-action { height: 44px; }
.list-row .utility-links { color: #761f32; border-top: 1px solid #ebe4e2; margin: 9px 0 0; padding-top: 6px; }
.list-row > view:nth-child(3) { font-size: 14px; }
