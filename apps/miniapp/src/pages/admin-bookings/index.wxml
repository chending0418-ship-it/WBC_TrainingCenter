<import src="../../calendar/week.wxml" />
<view wx:if="{{authorized}}" class="page-shell">
  <view class="{{!adding && !loading && !loadError ? 'screen-heading' : ''}}">
    <text class="page-title" role="heading" aria-level="1">{{adding ? '为家长代约' : '预约管理'}}</text>
    <button wx:if="{{!adding && !loading && !loadError}}" class="button row-action" bindtap="startBooking" disabled="{{busy}}" hover-class="press">为家长代约</button>
  </view>
  <view wx:if="{{!adding}}" class="section-actions review-tabs">
    <button size="mini" class="button {{pendingOnly ? '' : 'quiet'}}" data-view="pending" bindtap="changeView" hover-class="press">待确认</button>
    <button size="mini" class="button {{pendingOnly ? 'quiet' : ''}}" data-view="week" bindtap="changeView" hover-class="press">按周查看</button>
  </view>
  <template wx:if="{{!adding && !pendingOnly && weekStart}}" is="week" data="{{weekLabel, hasPrevious: true, hasNext, dates, today, lastDate, date: weekStart, canPick: true, allowHistory: true, bookingWeek: true, showDays: true, busy}}" />
  <picker wx:if="{{date && adding}}" mode="date" start="{{today}}" end="{{lastDate}}" value="{{date}}" bindchange="changeDate" disabled="{{busy}}">
    <view class="picker"><text class="picker-label">预约日期</text><text class="picker-value">{{date}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
  </picker>

  <block wx:if="{{adding}}">
    <view class="section-actions review-tabs">
      <button size="mini" class="button {{type === 'GROUP' ? '' : 'quiet'}}" data-type="GROUP" bindtap="changeType" aria-pressed="{{type === 'GROUP'}}" hover-class="press">团课</button>
      <button size="mini" class="button {{type === 'PRIVATE' ? '' : 'quiet'}}" data-type="PRIVATE" bindtap="changeType" aria-pressed="{{type === 'PRIVATE'}}" hover-class="press">私教</button>
    </view>
    <button size="mini" class="family-choice" bindtap="chooseFamily" disabled="{{busy}}" hover-class="press">
      <text class="muted">队员账户</text><text class="family-choice-name">{{family ? family.label : '搜索并选择队员'}}</text><view class="chevron"></view>
    </button>
    <picker wx:if="{{type === 'PRIVATE'}}" class="filter-row" range="{{privateTypes}}" range-key="name"
      value="{{privateTypeIndex}}" bindchange="changePrivateType" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">私教课程</text><text class="picker-value">{{privateTypes[privateTypeIndex].name}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
    </picker>
    <picker wx:if="{{type === 'PRIVATE' && coaches.length}}" class="filter-row" range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="changeCoach" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">教练</text><text class="picker-value">{{coaches[coachIndex].name}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
    </picker>
    <view wx:if="{{choicesLoading}}" class="message">正在查询可约课程…</view>
    <view wx:elif="{{choicesError}}" class="message">
      <view>{{choicesError}}</view><button class="button quiet" bindtap="refreshChoices" hover-class="press">重新查询</button>
    </view>
    <picker wx:elif="{{type === 'GROUP' && classes.length}}" class="filter-row" range="{{classes}}" range-key="label" value="{{optionIndex}}" bindchange="changeOption" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">团课</text><text class="picker-value">{{classes[optionIndex].label}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
    </picker>
    <picker wx:elif="{{type === 'PRIVATE' && slots.length}}" class="filter-row" range="{{slots}}" range-key="label" value="{{optionIndex}}" bindchange="changeOption" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">时段</text><text class="picker-value">{{slots[optionIndex].label}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
    </picker>
    <view wx:else class="message">没有可约课程或时段，试试其他日期。</view>
    <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    <view class="section-actions form-actions">
      <button class="button quiet" bindtap="closeForm" disabled="{{busy}}" hover-class="press">返回</button>
      <button class="button" bindtap="book" loading="{{busy}}" disabled="{{busy || choicesLoading || !family || !(classes.length || slots.length)}}" hover-class="press">确认代约</button>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="message">正在查询预约…</view>
  <view wx:elif="{{loadError}}" class="message">
    <view>{{loadError}}</view><button class="button quiet" bindtap="load" hover-class="press">重新查询</button>
  </view>
  <block wx:else>
    <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    <view wx:if="{{!bookings.length}}" class="message">{{pendingOnly ? '没有待确认的申请。' : '这周还没有预约。'}}</view>
    <block wx:for="{{bookings}}" wx:key="id">
      <view wx:if="{{item.dayHeading}}" id="agenda-{{item.day}}" class="section-title">{{item.dayHeading}}</view>
      <view class="list-row">
        <view class="row-line"><text class="row-name">{{item.childName}} · {{item.title}}</text><text class="booking-status">{{item.statusLabel}}</text></view>
        <view>{{item.type === 'GROUP' ? '团课' : '私教'}} · {{item.hours}} · {{item.coachLabel}}</view>
        <view class="muted">{{item.venue}} · {{item.points}} 积分</view>
        <view class="muted">{{item.staffCreated ? '管理员代约' : '家长预约'}}{{item.staffCancelled ? ' · 管理员取消' : ''}}</view>
        <view wx:if="{{item.status === 'PENDING'}}" class="section-actions item-actions">
          <button wx:if="{{item.canApprove}}" class="button" data-id="{{item.id}}" data-action="approve" bindtap="decide" disabled="{{busy}}" hover-class="press">确认预约</button>
          <button class="button quiet" data-id="{{item.id}}" data-action="reject" bindtap="decide" disabled="{{busy}}" hover-class="press">拒绝申请</button>
        </view>
        <button wx:if="{{item.canCancel}}" class="button quiet row-action" data-id="{{item.id}}" data-action="cancel" bindtap="decide" disabled="{{busy}}" hover-class="press">取消预约</button>
        <view wx:if="{{item.status === 'CONFIRMED' && !item.canCancel}}" class="muted">已过取消截止时间</view>
        <view wx:if="{{item.status === 'CANCELLED' && item.refundPoints > 0}}" class="muted">已退回 {{item.refundPoints}} 积分</view>
      </view>
    </block>
  </block>
</view>
