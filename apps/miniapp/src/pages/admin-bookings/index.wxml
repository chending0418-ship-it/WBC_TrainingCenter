<view class="page-shell">
  <text class="page-title" role="heading" aria-level="1">{{adding ? '为家长代约' : '预约管理'}}</text>
  <picker wx:if="{{date}}" mode="date" start="{{adding ? today : ''}}" end="{{lastDate}}" value="{{date}}" bindchange="changeDate" disabled="{{busy}}">
    <view class="picker"><text class="picker-label">预约日期</text><text class="picker-value">{{date}}</text></view>
  </picker>

  <block wx:if="{{adding}}">
    <view class="section-actions">
      <button class="button {{type === 'GROUP' ? '' : 'quiet'}}" data-type="GROUP" bindtap="changeType" aria-pressed="{{type === 'GROUP'}}" hover-class="press">团课</button>
      <button class="button {{type === 'PRIVATE' ? '' : 'quiet'}}" data-type="PRIVATE" bindtap="changeType" aria-pressed="{{type === 'PRIVATE'}}" hover-class="press">私教</button>
    </view>
    <picker wx:if="{{users.length}}" class="filter-row" range="{{users}}" range-key="label" value="{{userIndex}}" bindchange="changeUser" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">家长账户</text><text class="picker-value">{{users[userIndex].label}}</text></view>
    </picker>
    <view wx:else class="message">没有已填写孩子姓名的家长账户。</view>
    <picker wx:if="{{type === 'PRIVATE' && coaches.length}}" class="filter-row" range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="changeCoach" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">教练</text><text class="picker-value">{{coaches[coachIndex].name}}</text></view>
    </picker>
    <view wx:if="{{choicesLoading}}" class="message">正在查询可约课程…</view>
    <view wx:elif="{{choicesError}}" class="message">
      <view>{{choicesError}}</view><button class="button quiet" bindtap="refreshChoices" hover-class="press">重新查询</button>
    </view>
    <picker wx:elif="{{type === 'GROUP' && classes.length}}" class="filter-row" range="{{classes}}" range-key="label" value="{{optionIndex}}" bindchange="changeOption" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">团课</text><text class="picker-value">{{classes[optionIndex].label}}</text></view>
    </picker>
    <picker wx:elif="{{type === 'PRIVATE' && slots.length}}" class="filter-row" range="{{slots}}" range-key="label" value="{{optionIndex}}" bindchange="changeOption" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">时段</text><text class="picker-value">{{slots[optionIndex].label}}</text></view>
    </picker>
    <view wx:else class="message">没有可约课程或时段，试试其他日期。</view>
    <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    <view class="section-actions">
      <button class="button quiet" bindtap="closeForm" disabled="{{busy}}" hover-class="press">返回</button>
      <button class="button" bindtap="book" loading="{{busy}}" disabled="{{busy || choicesLoading || !users.length || !(classes.length || slots.length)}}" hover-class="press">确认代约</button>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="message">正在查询预约…</view>
  <view wx:elif="{{loadError}}" class="message">
    <view>{{loadError}}</view><button class="button quiet" bindtap="load" hover-class="press">重新查询</button>
  </view>
  <block wx:else>
    <button class="button row-action" bindtap="startBooking" disabled="{{busy}}" hover-class="press">为家长代约</button>
    <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    <view wx:if="{{!bookings.length}}" class="message">这天还没有预约。</view>
    <view wx:for="{{bookings}}" wx:key="id" class="list-row">
      <view class="row-line"><text class="row-name">{{item.childName}} · {{item.title}}</text><text class="muted">{{item.status === 'CANCELLED' ? '已取消' : '已确认'}}</text></view>
      <view>{{item.hours}} · {{item.coachName}}教练</view>
      <view class="muted">{{item.venue}} · {{item.points}} 积分</view>
      <view class="muted">{{item.staffCreated ? '管理员代约' : '家长预约'}}{{item.staffCancelled ? ' · 管理员取消' : ''}}</view>
      <button wx:if="{{item.status === 'CONFIRMED'}}" class="button quiet row-action" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}" hover-class="press">取消预约</button>
    </view>
  </block>
</view>
