.page-shell .text-link, .page-shell .family-row { border: 0; background: transparent; margin: 0; padding: 0; text-align: left; font: inherit; }
.page-shell .text-link::after, .page-shell .family-row::after { border: 0; }
.page-shell .text-link { flex: none; width: auto; color: #761f32; font-size: 14px; }
.family-search, .family-list { background: white; border: 1px solid #d5c4c5; border-radius: 9px; }
.family-search { box-sizing: border-box; display: flex; align-items: center; gap: 10px; min-height: 46px; padding: 8px 12px; border-radius: 8px; }
.family-search input { min-width: 0; flex: 1; height: 25px; border: 0; background: transparent; }
.search-glass { box-sizing: border-box; position: relative; flex: none; margin-right: 2px; width: 14px; height: 14px; border: 1.6px solid #66595c; border-radius: 50%; }
.search-glass::after { content: ""; position: absolute; width: 6px; height: 1.5px; background: #66595c; right: -5px; bottom: -2px; transform: rotate(45deg); }
.results-heading, .page-shell .family-row, .family-birth { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.results-heading { margin: 22px 0 9px; }
.results-heading .section-title { margin: 0; }
.family-list { overflow: hidden; border-radius: 10px; border-color: #ded5d3; }
.page-shell .family-row { width: 100%; border-radius: 0; padding: 13px 14px; line-height: 1.55; }
.page-shell .family-row + .family-row { border-top: 1px solid #e6dfdc; }
.family-birth { flex-shrink: 0; }
.hint { margin: 7px 0 15px; font-size: 14px; line-height: 1.65; }
.page-title { margin-bottom: 18px; }
.page-shell .family-row .row-name { line-height: 1.55; }
