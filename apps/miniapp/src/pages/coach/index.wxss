.coach-toolbar {
  align-items: center;
  flex-wrap: wrap;
}

.coach-toolbar .profile-avatar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  width: auto;
  margin: 0 auto 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: left;
  line-height: 1.5;
  font-size: 30rpx;
}

.profile-avatar::after {
  border: 0;
}

.coach-toolbar + .review-tabs { margin-top: 8px; }
