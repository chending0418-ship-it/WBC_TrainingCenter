.price-heading { font-size: 14px; font-weight: 650; }
.price-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.price-grid .form-field { margin: 5px 0 14px; }
.price-grid .field { width: 100%; }
.price-grid text { display: block; }

.form-field textarea.field { box-sizing: border-box; width: 100%; height: 96px; padding: 8px 12px; }
