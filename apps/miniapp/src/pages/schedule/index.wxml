<import src="../../calendar/week.wxml" />
<import src="../../calendar/groups.wxml" />
<page-meta page-style="{{confirmation || registrationPrompt ? 'overflow: hidden' : ''}}" />
<view wx:if="{{authorized}}" class="page-shell parent-tab-page calendar-page">
  <text class="page-title" role="heading" aria-level="1">课程表</text>

  <view wx:if="{{loading}}" class="message">正在加载排课…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重新加载</button>
  </view>

  <block wx:if="{{today}}">
    <view class="calendar-tabs">
      <button class="calendar-tab {{mode === 'GROUP' ? 'active' : ''}}" data-mode="GROUP"
        bindtap="changeMode" hover-class="press" aria-pressed="{{mode === 'GROUP'}}">团课</button>
      <button class="calendar-tab {{mode === 'PRIVATE' ? 'active' : ''}}" data-mode="PRIVATE"
        bindtap="changeMode" hover-class="press" aria-pressed="{{mode === 'PRIVATE'}}">私教</button>
    </view>

    <template is="week" data="{{weekLabel, hasPrevious, hasNext, dates, today, showDays: mode === 'GROUP', busy: booking}}" />

    <block wx:if="{{mode === 'GROUP'}}">
      <template is="groups" data="{{groups, total, today, booking, showBooking: true}}" />
    </block>

    <block wx:else>
      <scroll-view wx:if="{{coaches.length}}" class="coach-strip" scroll-x="{{true}}" aria-label="选择私教教练">
        <view class="coach-choices">
          <button wx:for="{{coaches}}" wx:key="id" class="coach-choice {{index === coachIndex ? 'active' : ''}}"
            data-index="{{index}}" bindtap="changeCoach" disabled="{{booking}}" hover-class="press"
            aria-pressed="{{index === coachIndex}}" aria-label="{{item.label}}">
            <view class="coach-face">
              <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" data-index="{{index}}" data-url="{{item.avatarUrl}}" binderror="avatarFailed" />
              <text wx:else>{{item.initial}}</text>
            </view>
            <text class="coach-name">{{item.label}}</text>
          </button>
        </view>
      </scroll-view>
      <view wx:if="{{slotLoading}}" class="message">正在查询可约时段…</view>
      <view wx:elif="{{slotError}}" class="message">
        <view>{{slotError}}</view>
        <button class="button quiet" bindtap="refreshSlots" hover-class="press">重新查询</button>
      </view>
      <view wx:if="{{!slotLoading && !coaches.length}}" class="message">暂无开放私教预约的教练。</view>
      <block wx:elif="{{!slotLoading && (privateDays.length || !slotError)}}">
        <view class="section-title" role="heading" aria-level="2">可约时段</view>
        <view wx:for="{{privateDays}}" wx:key="date" wx:for-item="day" wx:for-index="di" class="availability-day">
          <view class="row-name">{{day.label}}</view>
          <text wx:if="{{!day.ranges.length}}" class="card-note">暂无可约时段</text>
          <view wx:for="{{day.ranges}}" wx:key="startsAt" wx:for-item="range" wx:for-index="ri" class="time-range">
            <button class="button quiet range-toggle" data-range="{{range.startsAt}}" bindtap="toggleRange"
              aria-expanded="{{selectedRange === range.startsAt}}" disabled="{{booking}}" hover-class="press">
              <text>{{range.label}}</text><text class="range-action">{{selectedRange === range.startsAt ? '收起' : '选时段'}}</text>
            </button>
            <view wx:if="{{selectedRange === range.startsAt}}" class="range-detail">
              <view class="card-note">选择开始时间</view>
              <view class="start-options">
                <button wx:for="{{range.starts}}" wx:key="startsAt" wx:for-item="start" class="button {{selectedStart === start.startsAt ? '' : 'quiet'}}"
                  data-start="{{start.startsAt}}" bindtap="chooseStart" disabled="{{booking}}" aria-pressed="{{selectedStart === start.startsAt}}" hover-class="press">{{start.label}}</button>
              </view>
              <block wx:for="{{range.starts}}" wx:key="startsAt" wx:for-item="start" wx:for-index="si">
                <block wx:if="{{selectedStart === start.startsAt}}">
                  <view class="card-note">选择时长，核对预约</view>
                  <view class="end-options">
                    <button wx:for="{{start.options}}" wx:key="endsAt" wx:for-item="option" wx:for-index="ei" class="button quiet"
                      data-day="{{di}}" data-range="{{ri}}" data-start="{{si}}" data-end="{{ei}}" bindtap="bookPrivate" disabled="{{booking}}" hover-class="press">
                      <text class="end-time">{{option.minutes}} 分钟 · {{option.points}} 积分</text>
                      <text class="end-price">{{option.endLabel}} 结束</text>
                    </button>
                  </view>
                </block>
              </block>
            </view>
          </view>
        </view>
      </block>
    </block>
  </block>
  <view wx:if="{{registrationPrompt}}" class="quote-overlay">
    <view class="quote-dialog registration-dialog" aria-role="dialog" aria-label="队员注册">
      <view class="card-title">{{registrationPrompt.newPlayer ? '预约前请先注册队员' : '查看队员注册进度'}}</view>
      <view class="registration-course"><text class="row-name">{{registrationPrompt.title}}</text><text class="card-note">{{registrationPrompt.when}}</text></view>
      <view class="card-note">{{registrationPrompt.newPlayer ? '填写队员资料，管理员批准后，就可以回来预约。' : '注册审核通过后，就可以回来预约。'}}</view>
      <view class="quote-actions"><button class="button quiet" bindtap="dismissRegistration">继续看课</button><button class="button" bindtap="openRegistration">{{registrationPrompt.newPlayer ? '注册队员' : '查看申请'}}</button></view>
    </view>
  </view>
  <subscription-reminder id="resultReminder" topic="booking" manual="{{false}}" />
  <view wx:if="{{confirmation}}" class="quote-overlay">
    <view class="quote-dialog" aria-role="dialog" aria-label="提交预约申请">
      <view class="card-title">提交预约申请</view>
      <view class="quote-title">{{confirmation.title}}</view>
      <view class="quote-details">
        <text>时间</text><text>{{confirmation.when}}</text>
        <text>教练</text><text>{{confirmation.coach}}</text>
        <text>场地</text><text>{{confirmation.venue}}</text>
        <text>积分</text><text>确认后扣除 {{confirmation.points}} 积分</text>
        <text>按时取消</text><text>{{confirmation.refundPoints ? '退回 ' + confirmation.refundPoints + ' 积分' : '不退积分'}}</text>
      </view>
      <view class="quote-actions">
        <button class="button quiet" bindtap="dismissQuote" disabled="{{booking}}" hover-class="press">取消</button>
        <button class="button" bindtap="submitQuote" disabled="{{booking}}" loading="{{booking}}" hover-class="press">提交申请</button>
      </view>
    </view>
  </view>
</view>
