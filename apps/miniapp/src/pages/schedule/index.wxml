<view wx:if="{{authorized}}" class="page-shell">
  <text class="page-title" role="heading" aria-level="1">课程表</text>

  <view wx:if="{{loading}}" class="message">正在加载排课…</view>
  <view wx:elif="{{error}}" class="message">
    <view>{{error}}</view>
    <button class="button quiet" bindtap="refresh" hover-class="press">重新加载</button>
  </view>

  <block wx:else>
    <view class="modes">
      <button class="button {{mode === 'GROUP' ? '' : 'quiet'}}" data-mode="GROUP"
        bindtap="changeMode" hover-class="press" aria-pressed="{{mode === 'GROUP'}}">团课</button>
      <button class="button {{mode === 'PRIVATE' ? '' : 'quiet'}}" data-mode="PRIVATE"
        bindtap="changeMode" hover-class="press" aria-pressed="{{mode === 'PRIVATE'}}">私教</button>
    </view>

    <view class="week">
      <button class="button quiet week-step" data-step="-1" disabled="{{!hasPrevious || booking}}"
        bindtap="changeWeek" hover-class="press">上一周</button>
      <text class="week-label">{{weekLabel}}</text>
      <button class="button quiet week-step" data-step="1" disabled="{{!hasNext || booking}}"
        bindtap="changeWeek" hover-class="press">下一周</button>
    </view>
    <view wx:if="{{mode === 'GROUP'}}" class="dates">
      <button wx:for="{{dates}}" wx:key="date" class="button day {{date === item.date ? 'selected' : ''}}"
        data-date="{{item.date}}" bindtap="changeDate" hover-class="press"
        aria-label="{{item.date}} 周{{item.weekday}}{{item.hasGroup ? '，有团课' : ''}}" aria-pressed="{{date === item.date}}">
        <text class="weekday">{{item.date === today ? '今' : item.weekday}}</text>
        <text class="day-number">{{item.day}}</text>
        <view wx:if="{{item.hasGroup}}" class="course-dot" aria-hidden="true"></view>
      </button>
    </view>

    <block wx:if="{{mode === 'GROUP'}}">
      <view wx:if="{{!courses.length}}" class="message">这天没有团课，可以选择其他日期。</view>
      <view wx:for="{{courses}}" wx:key="id" class="lesson-card group-course">
        <view class="course-heading">
          <text class="card-title">{{item.title}}</text>
          <text class="card-time">{{item.hours}}</text>
        </view>
        <view class="card-note">{{item.coachLabel}} · {{item.venue}}{{item.courseTypeName && item.courseTypeName !== item.title ? ' · ' + item.courseTypeName : ''}}</view>
        <view class="course-action">
          <view class="course-facts">
            <text class="course-points">{{item.points}} 积分</text>
            <text class="accent">剩余 {{item.capacity - item.bookedCount}} 位</text>
            <text>已占 {{item.bookedCount}}/{{item.capacity}}</text>
          </view>
          <view class="booking-control">
            <text wx:if="{{item.unavailable}}" class="course-status">{{item.action}}</text>
            <button wx:else class="button book-button" data-id="{{item.id}}" bindtap="bookGroup" hover-class="press"
              disabled="{{booking}}" aria-label="{{item.title}} 预约">预约</button>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <picker wx:if="{{coaches.length}}" class="filter-row" range="{{coaches}}" range-key="name" value="{{coachIndex}}"
        bindchange="changeCoach" disabled="{{booking}}">
        <view class="picker"><text class="picker-label">私教教练</text><text class="picker-value">{{coaches[coachIndex].name}}教练</text></view>
      </picker>
      <view wx:if="{{slotLoading}}" class="message">正在查询可约时段…</view>
      <view wx:elif="{{slotError}}" class="message">
        <view>{{slotError}}</view>
        <button class="button quiet" bindtap="refreshSlots" hover-class="press">重新查询</button>
      </view>
      <view wx:elif="{{!coaches.length}}" class="message">暂无开放私教预约的教练。</view>
      <block wx:else>
        <view class="section-title" role="heading" aria-level="2">可约时段</view>
        <view wx:for="{{privateDays}}" wx:key="date" wx:for-item="day" wx:for-index="di" class="availability-day">
          <view class="row-name">{{day.label}}</view>
          <text wx:if="{{!day.ranges.length}}" class="card-note">暂无可约时段</text>
          <view wx:for="{{day.ranges}}" wx:key="startsAt" wx:for-item="range" wx:for-index="ri" class="time-range">
            <button class="button quiet range-toggle" data-range="{{range.startsAt}}" bindtap="toggleRange"
              aria-expanded="{{selectedRange === range.startsAt}}" disabled="{{booking}}" hover-class="press">
              <text>{{range.label}}</text><text class="range-action">{{selectedRange === range.startsAt ? '收起' : '选时段'}}</text>
            </button>
            <view wx:if="{{selectedRange === range.startsAt}}" class="range-detail">
              <view class="card-note">选择开始时间</view>
              <view class="start-options">
                <button wx:for="{{range.starts}}" wx:key="startsAt" wx:for-item="start" class="button {{selectedStart === start.startsAt ? '' : 'quiet'}}"
                  data-start="{{start.startsAt}}" bindtap="chooseStart" disabled="{{booking}}" aria-pressed="{{selectedStart === start.startsAt}}" hover-class="press">{{start.label}}</button>
              </view>
              <block wx:for="{{range.starts}}" wx:key="startsAt" wx:for-item="start" wx:for-index="si">
                <block wx:if="{{selectedStart === start.startsAt}}">
                  <view class="card-note">选择时长，核对预约</view>
                  <view class="end-options">
                    <button wx:for="{{start.options}}" wx:key="endsAt" wx:for-item="option" wx:for-index="ei" class="button quiet"
                      data-day="{{di}}" data-range="{{ri}}" data-start="{{si}}" data-end="{{ei}}" bindtap="bookPrivate" disabled="{{booking}}" hover-class="press">
                      <text class="end-time">{{option.minutes}} 分钟 · {{option.points}} 积分</text>
                      <text class="end-price">{{option.endLabel}} 结束</text>
                    </button>
                  </view>
                </block>
              </block>
            </view>
          </view>
        </view>
      </block>
    </block>
  </block>
</view>
