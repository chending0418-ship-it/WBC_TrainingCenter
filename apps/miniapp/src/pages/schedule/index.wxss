.page-title {
  margin-bottom: 24rpx;
}

.modes, .week {
  display: flex;
  align-items: center;
}

.modes {
  gap: 32rpx;
  border-bottom: 1rpx solid #ded5d3;
}

.modes .mode-tab, .week .week-step {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
}

.mode-tab::after, .week-step::after {
  border: 0;
}

.modes .mode-tab {
  position: relative;
  width: auto;
  min-width: 44px;
  min-height: 44px;
  color: #66595c;
  font-size: 32rpx;
  line-height: 44px;
}

.modes .mode-tab.active {
  color: #761f32;
  font-weight: 650;
}

.mode-tab.active::before {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 32rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #761f32;
  content: "";
  transform: translateX(-50%);
}

.week {
  margin: 24rpx 0 16rpx;
}

.week-label {
  flex: 1;
  font-size: 32rpx;
  font-weight: 650;
}

.week .week-step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  color: #761f32;
}

.week .week-step[disabled] {
  color: #aa9d9f;
  background: transparent;
}

.chevron {
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  transform: rotate(45deg);
}

.previous .chevron {
  transform: rotate(-135deg);
}

.dates {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  column-gap: 4rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #ded5d3;
}

.dates .button.day {
  position: relative;
  width: 100%;
  margin: 0;
  padding: 14rpx 0 28rpx;
  border: 0;
  background: transparent;
  color: #272327;
  line-height: 1.3;
}

.dates .day.selected {
  background: #f0dfe3;
  color: #761f32;
}

.weekday, .day-number {
  display: block;
}

.weekday {
  color: #66595c;
  font-size: 24rpx;
  font-weight: 500;
}

.day-number {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.course-dot {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: #bd2944;
}

.lesson-card.group-course {
  margin: 24rpx 0;
  padding: 24rpx;
  line-height: 1.45;
}

.course-heading, .course-action {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
}

.course-heading .card-time {
  font-size: 28rpx;
  white-space: nowrap;
}

.group-course .card-note {
  margin-top: 8rpx;
}

.course-action {
  margin-top: 20rpx;
}

.course-facts {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4rpx 14rpx;
  color: #66595c;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.course-points {
  color: #272327;
  font-size: 28rpx;
  font-weight: 650;
}

.booking-control {
  width: 116rpx;
  text-align: right;
}

.course-status {
  color: #66595c;
  font-size: 26rpx;
}

.booking-control .book-button {
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 10rpx 0;
}

.end-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 10rpx;
}

.end-options .button {
  width: 100%;
  padding: 14rpx 6rpx;
}

.end-time, .end-price {
  display: block;
  font-variant-numeric: tabular-nums;
}

.end-price {
  font-size: 24rpx;
  font-weight: 500;
}

.availability-day {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

.time-range {
  margin-top: 10rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d5c4c5;
  border-radius: 16rpx;
  background: #fff;
}

.button.range-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 16rpx 0;
  border: 0;
  font-variant-numeric: tabular-nums;
}

.range-action {
  font-size: 24rpx;
}

.range-detail {
  padding: 12rpx 0 22rpx;
  border-top: 1rpx solid #e6dfdc;
}

.start-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin: 12rpx 0 18rpx;
}

.start-options .button {
  width: 100%;
  padding: 12rpx 4rpx;
}

.coach-strip {
  width: 100%;
  margin: 18rpx 0;
}

.coach-choices {
  display: inline-flex;
  gap: 14rpx;
  padding: 6rpx 4rpx;
}

.coach-choices .coach-choice {
  margin: 0;
  display: flex;
  flex: 0 0 120rpx;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 4rpx;
  border: 0;
  background: transparent;
  color: #66595c;
  line-height: 1.35;
}

.coach-choice::after {
  border: none;
}

.coach-choice.active .coach-face {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 6rpx #761f32;
}

.coach-name {
  max-width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.coach-choice.active .coach-name {
  color: #761f32;
  font-weight: 650;
}

.coach-strip + .section-title {
  margin-top: 20rpx;
}

.quote-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 36rpx;
  background: rgba(30, 23, 25, .45);
}

.quote-dialog {
  box-sizing: border-box;
  width: 100%;
  max-height: 90%;
  overflow: auto;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #fff;
  text-align: left;
}

.quote-title {
  margin: 18rpx 0 12rpx;
  font-weight: 650;
}

.quote-details {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 8rpx 24rpx;
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.quote-details text:nth-child(odd) {
  color: #66595c;
}

.quote-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 14rpx;
  margin-top: 26rpx;
}

.quote-actions .button {
  width: 100%;
  margin: 0;
}
