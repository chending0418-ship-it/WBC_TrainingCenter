.modes, .week, .dates, .course-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modes {
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.modes .button {
  flex: 1;
}

.week {
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.week-step {
  flex: 0 0 126rpx;
  width: 126rpx;
  min-height: 80rpx;
  padding: 18rpx 12rpx;
  font-size: 24rpx;
}

.week-label {
  flex: 1;
  color: #66595c;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.dates {
  justify-content: flex-start;
  gap: 5rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ded5d3;
}

.day {
  flex: 0 0 calc((100% - 30rpx) / 7);
  min-width: 0;
  padding: 12rpx 0;
  background: transparent;
  color: #272327;
}

.day.selected {
  border-color: #d5b9bf;
  background: #f0dfe3;
  color: #761f32;
}

.weekday, .day-number {
  display: block;
}

.weekday {
  font-size: 24rpx;
  font-weight: 500;
}

.day-number, .course-time {
  font-variant-numeric: tabular-nums;
}

.course-title {
  font-size: 34rpx;
  font-weight: 650;
}

.course-time {
  font-size: 26rpx;
  white-space: nowrap;
}

.course-action {
  gap: 12rpx;
  margin-top: 22rpx;
}

.course-action .button {
  flex: 0 0 162rpx;
  width: 162rpx;
}

.time-pickers {
  display: grid;
  gap: 12rpx;
  margin-top: 12rpx;
}

.private-venue {
  margin: 18rpx 0;
}
