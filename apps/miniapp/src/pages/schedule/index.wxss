@import "../../calendar/week.wxss";
@import "../../registration/dialog.wxss";

.end-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 10rpx;
}

.end-options .button {
  width: 100%;
  padding: 14rpx 6rpx;
}

.end-time, .end-price {
  display: block;
  font-variant-numeric: tabular-nums;
}

.end-price {
  font-size: 24rpx;
  font-weight: 500;
}

.availability-day {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

.time-range {
  margin-top: 10rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d5c4c5;
  border-radius: 16rpx;
  background: #fff;
}

.button.range-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 16rpx 0;
  border: 0;
  font-variant-numeric: tabular-nums;
}

.range-action {
  font-size: 24rpx;
}

.range-detail {
  padding: 12rpx 0 22rpx;
  border-top: 1rpx solid #e6dfdc;
}

.start-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin: 12rpx 0 18rpx;
}

.start-options .button {
  width: 100%;
  padding: 12rpx 4rpx;
}

.coach-strip {
  width: 100%;
  margin: 18rpx 0;
}

.coach-choices {
  display: inline-flex;
  gap: 14rpx;
  padding: 6rpx 4rpx;
}

.coach-choices .coach-choice {
  margin: 0;
  display: flex;
  flex: 0 0 120rpx;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 4rpx;
  border: 0;
  background: transparent;
  color: #66595c;
  line-height: 1.35;
}

.coach-choice::after {
  border: none;
}

.coach-choice.active .coach-face {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 6rpx #761f32;
}

.coach-name {
  max-width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.coach-choice.active .coach-name {
  color: #761f32;
  font-weight: 650;
}

.coach-strip + .section-title {
  margin-top: 20rpx;
}

.quote-title {
  margin: 18rpx 0 12rpx;
  font-weight: 650;
}

.quote-details {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 8rpx 24rpx;
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.quote-details text:nth-child(odd) {
  color: #66595c;
}

.quote-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 14rpx;
  margin-top: 26rpx;
}

.quote-actions .button {
  width: 100%;
  margin: 0;
}
