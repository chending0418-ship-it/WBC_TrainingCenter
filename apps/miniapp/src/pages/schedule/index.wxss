@import "../../calendar/week.wxss";
@import "../../registration/dialog.wxss";

.end-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.6vw;
  margin-top: 1.333vw;
}

.end-options .button {
  width: 100%;
  padding: 1.867vw 0.8vw;
}

.end-time, .end-price {
  display: block;
  font-variant-numeric: tabular-nums;
}

.end-price {
  font-size: 3.2vw;
  font-weight: 500;
}

.availability-day {
  padding: 2.667vw 0;
  border-bottom: 1rpx solid #ded5d3;
}

.time-range {
  margin-top: 1.333vw;
  padding: 0 2.667vw;
  border: 1rpx solid #d5c4c5;
  border-radius: 2.133vw;
  background: #fff;
}

.button.range-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 2.133vw 0;
  border: 0;
  font-variant-numeric: tabular-nums;
}

.range-action {
  font-size: 3.2vw;
}

.range-detail {
  padding: 1.6vw 0 2.933vw;
  border-top: 1rpx solid #e6dfdc;
}

.start-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.333vw;
  margin: 1.6vw 0 2.4vw;
}

.start-options .button {
  width: 100%;
  padding: 1.6vw 0.533vw;
}

.coach-strip {
  width: 100%;
  margin: 2.4vw 0;
}

.coach-choices {
  display: inline-flex;
  gap: 1.867vw;
  padding: 0.8vw 0.533vw;
}

.coach-choices .coach-choice {
  margin: 0;
  display: flex;
  flex: 0 0 16vw;
  flex-direction: column;
  align-items: center;
  width: 16vw;
  padding: 0.533vw;
  border: 0;
  background: transparent;
  color: #66595c;
  line-height: 1.35;
}

.coach-choice::after {
  border: none;
}

.coach-choice.active .coach-face {
  box-shadow: 0 0 0 0.4vw #fff, 0 0 0 0.8vw #761f32;
}

.coach-name {
  max-width: 100%;
  margin-top: 1.6vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 3.2vw;
}

.coach-choice.active .coach-name {
  color: #761f32;
  font-weight: 650;
}

.coach-strip + .section-title {
  margin-top: 2.667vw;
}

.quote-title {
  margin: 2.4vw 0 1.6vw;
  font-weight: 650;
}

.quote-details {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 1.067vw 3.2vw;
  font-size: 3.733vw;
  overflow-wrap: anywhere;
}

.quote-details text:nth-child(odd) {
  color: #66595c;
}

.quote-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 1.867vw;
  margin-top: 3.467vw;
}

.quote-actions .button {
  width: 100%;
  margin: 0;
}

.agenda-buttons { display: flex; align-items: center; gap: 1.6vw; flex-shrink: 0; }
.detail-scroll { max-height: 50vh; }
.detail-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; }
.detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.detail-heading .button.detail-close { flex: none; width: auto; min-width: 48px; margin: 0; }
.agenda-heading button.button.row-action { margin: 0 0 0 auto; }
