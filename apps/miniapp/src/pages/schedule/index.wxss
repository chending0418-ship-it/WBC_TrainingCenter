.modes, .week, .dates, .course-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modes {
  gap: 12rpx;
  margin-bottom: 34rpx;
}

.modes .button {
  flex: 1;
}

.week {
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.week-step {
  flex: 0 0 126rpx;
  width: 126rpx;
  min-height: 80rpx;
  padding: 18rpx 12rpx;
  font-size: 24rpx;
}

.week-label {
  flex: 1;
  color: #66595c;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.dates {
  justify-content: flex-start;
  gap: 5rpx;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid #ded5d3;
}

.day {
  flex: 0 0 calc((100% - 30rpx) / 7);
  min-width: 0;
  padding: 12rpx 0;
  background: transparent;
  color: #272327;
}

.day.selected {
  border-color: #d5b9bf;
  background: #f0dfe3;
  color: #761f32;
}

.weekday, .day-number {
  display: block;
}

.weekday {
  font-size: 24rpx;
  font-weight: 500;
}

.day-number {
  font-variant-numeric: tabular-nums;
}

.course-action {
  gap: 12rpx;
  margin-top: 26rpx;
}

.course-status {
  color: #66595c;
  font-size: 28rpx;
  text-align: right;
  white-space: nowrap;
}

.course-action .button {
  flex: 0 0 162rpx;
  width: 162rpx;
}

.end-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 10rpx;
}

.end-options .button {
  width: 100%;
  padding: 14rpx 6rpx;
}

.end-time, .end-price {
  display: block;
  font-variant-numeric: tabular-nums;
}

.end-price {
  font-size: 24rpx;
  font-weight: 500;
}

.course-capacity {
  color: #66595c;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

.availability-day {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ded5d3;
}

.time-range {
  margin-top: 10rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d5c4c5;
  border-radius: 16rpx;
  background: #fff;
}

.button.range-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 16rpx 0;
  border: 0;
  font-variant-numeric: tabular-nums;
}

.range-action {
  font-size: 24rpx;
}

.range-detail {
  padding: 12rpx 0 22rpx;
  border-top: 1rpx solid #e6dfdc;
}

.start-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin: 12rpx 0 18rpx;
}

.start-options .button {
  width: 100%;
  padding: 12rpx 4rpx;
}
