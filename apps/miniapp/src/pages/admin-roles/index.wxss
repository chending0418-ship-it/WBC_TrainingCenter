.user-toolbar { display: grid; grid-template-columns: minmax(0,1fr) auto 48px; align-items: center; gap: 6px; }
.user-toolbar .field { width: 100%; height: 34px; min-height: 34px; padding: 0 9px; font-size: 14px; }
.profile-filter, .user-toolbar button.button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 34px; min-height: 34px; margin: 0; padding: 0 9px; font-size: 13px; }
.user-toolbar button.button { width: 48px; padding: 0; }
.profile-filter { gap: 7px; border: 1px solid #d5c4c5; border-radius: 8px; background: white; }
.profile-filter .chevron { margin: -3px 2px 0 0; transform: rotate(135deg); }
