@import "../../calendar/week.wxss";

.lesson-card.weekly-hours {
  padding: 0 22rpx;
}

.weekday-row {
  padding: 4rpx 0;
}

.weekday-row + .weekday-row {
  border-top: 1rpx solid #e6dfdc;
}

.weekday-summary, .hours-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.weekday-summary {
  min-height: 64rpx;
}

.weekday-summary .row-name {
  flex-shrink: 0;
}

.weekday-times {
  color: #761f32;
  font-variant-numeric: tabular-nums;
  font-size: 28rpx;
}

.weekly-hours .button {
  flex-shrink: 0;
  width: auto;
  min-height: 60rpx;
  margin: 0;
  padding: 8rpx 14rpx;
  font-size: 26rpx;
}

.weekly-hours .edit-day, .weekly-hours .hours-link {
  border: 0;
  background: transparent;
}

.weekly-hours .edit-day {
  margin-left: auto;
}

.window-editor {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.window-editor .field {
  width: 100%;
  min-height: 64rpx;
  height: 64rpx;
  padding: 0 14rpx;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.hours-actions {
  padding: 8rpx 0;
}

.hours-actions .add-window {
  margin-right: auto;
  padding-left: 0;
}

.hours-actions .save-hours {
  padding-right: 26rpx;
  padding-left: 26rpx;
}
