<view class="page-shell">
  <text class="page-title" role="heading" aria-level="1">{{editor ? (editor.id ? '编辑班次' : '新增团课') : '排课管理'}}</text>
  <form wx:if="{{editor}}" bindsubmit="saveClass">
    <label class="form-field"><text>课程名称</text><input class="field" value="{{editor.title}}" data-field="title" bindinput="changeClassField" maxlength="50" placeholder="输入课程名称" disabled="{{busy}}" /></label>
    <picker range="{{coaches}}" range-key="name" value="{{editor.coachIndex}}" bindchange="changeClassCoach" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">教练</text><text class="picker-value">{{coaches[editor.coachIndex].name}}</text></view>
    </picker>
    <label class="form-field"><text>场地</text><input class="field" value="{{editor.venue}}" data-field="venue" bindinput="changeClassField" maxlength="50" disabled="{{busy}}" /></label>
    <picker mode="date" start="{{today}}" end="{{lastDate}}" value="{{editor.date}}" bindchange="changeClassDate" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">{{editor.repeat ? '起始日期' : '开课日期'}}</text><text class="picker-value">{{editor.date}}</text></view>
    </picker>
    <view wx:if="{{!editor.id}}" class="row-line filter-row"><text>按周重复</text><switch color="#761F32" checked="{{editor.repeat}}" bindchange="changeRepeat" disabled="{{busy}}" /></view>
    <view wx:if="{{editor.repeat}}">
      <view class="subheading">选择重复日期</view>
      <view class="selection-grid">
        <button wx:for="{{days}}" wx:key="index" class="button {{item.active ? '' : 'quiet'}}" data-index="{{item.index}}" bindtap="toggleDay" aria-pressed="{{item.active}}" disabled="{{busy}}" hover-class="press">{{item.label}}</button>
      </view>
    </view>
    <label class="form-field">
      <text>开课时间</text>
      <input class="field" value="{{editor.time}}" data-field="time" bindinput="changeClassField" maxlength="50" placeholder="例如 17:30" disabled="{{busy}}" />
      <view wx:if="{{editor.repeat}}" class="muted">同一天有多个时段时，用逗号分隔，例如 14:00，17:30。</view>
    </label>
    <label class="form-field"><text>时长（分钟）</text><input class="field" type="number" value="{{editor.duration}}" data-field="duration" bindinput="changeClassField" maxlength="3" disabled="{{busy}}" /></label>
    <label class="form-field"><text>容量（人）</text><input class="field" type="number" value="{{editor.capacity}}" data-field="capacity" bindinput="changeClassField" maxlength="3" disabled="{{busy}}" /></label>
    <label class="form-field"><text>所需积分</text><input class="field" type="number" value="{{editor.points}}" data-field="points" bindinput="changeClassField" maxlength="6" disabled="{{busy}}" /></label>
    <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    <view class="section-actions">
      <button class="button quiet" bindtap="closeEditor" disabled="{{busy}}" hover-class="press">返回</button>
      <button class="button" form-type="submit" loading="{{busy}}" disabled="{{busy}}" hover-class="press">保存排课</button>
    </view>
  </form>

  <block wx:else>
    <view class="section-actions">
      <button class="button {{mode === 'classes' ? '' : 'quiet'}}" data-mode="classes" bindtap="changeMode" aria-pressed="{{mode === 'classes'}}" hover-class="press">团课</button>
      <button class="button {{mode === 'hours' ? '' : 'quiet'}}" data-mode="hours" bindtap="changeMode" aria-pressed="{{mode === 'hours'}}" hover-class="press">私教时段</button>
    </view>
    <picker wx:if="{{date}}" mode="date" start="{{today}}" end="{{lastDate}}" value="{{date}}" bindchange="changeDate" disabled="{{busy}}">
      <view class="picker"><text class="picker-label">排课日期</text><text class="picker-value">{{date}} · {{dayLabel}}</text></view>
    </picker>
    <view wx:if="{{loading}}" class="message">正在加载排课…</view>
    <view wx:elif="{{loadError}}" class="message">
      <view>{{loadError}}</view><button class="button quiet" bindtap="load" hover-class="press">重新查询</button>
    </view>
    <block wx:elif="{{mode === 'classes'}}">
      <button class="button row-action" bindtap="newClass" disabled="{{busy}}" hover-class="press">新增团课</button>
      <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
      <view wx:if="{{!classes.length}}" class="message">这天还没有团课。</view>
      <view wx:for="{{classes}}" wx:key="id" class="list-row">
        <view class="row-line"><text class="row-name">{{item.title}}</text><text class="muted">{{item.status === 'CLOSED' ? '已停开' : '已发布'}}</text></view>
        <view>{{item.timeLabel}} · {{item.coachName}}教练</view>
        <view class="muted">{{item.venue}} · {{item.bookedCount}}/{{item.capacity}} 人 · {{item.points}} 积分</view>
        <view wx:if="{{item.names}}" class="details">已预约 {{item.names}}</view>
        <view wx:if="{{item.editable}}" class="section-actions">
          <button class="button quiet" data-id="{{item.id}}" bindtap="editClass" disabled="{{busy}}" hover-class="press">编辑班次</button>
          <button class="button quiet" data-id="{{item.id}}" bindtap="toggleClass" disabled="{{busy}}" hover-class="press">{{item.status === 'CLOSED' ? '恢复班次' : '停开班次'}}</button>
        </view>
      </view>
    </block>
    <block wx:elif="{{coaches.length}}">
      <picker class="filter-row" range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="changeHoursCoach" disabled="{{busy}}">
        <view class="picker"><text class="picker-label">教练</text><text class="picker-value">{{coaches[coachIndex].name}}教练</text></view>
      </picker>
      <view class="section-title" role="heading" aria-level="2">每{{dayLabel}}开放</view>
      <view class="muted">用 24 小时制填写，例如 14:00 和 16:30。</view>
      <view wx:if="{{!windows.length}}" class="muted">这一天没有固定开放时间。</view>
      <view wx:for="{{windows}}" wx:key="key" class="list-row">
        <view class="row-line">
          <label><text class="muted">开始</text><input class="field" value="{{item.start}}" data-index="{{index}}" data-side="start" maxlength="5" bindinput="changeWindow" disabled="{{busy}}" /></label>
          <label><text class="muted">结束</text><input class="field" value="{{item.end}}" data-index="{{index}}" data-side="end" maxlength="5" bindinput="changeWindow" disabled="{{busy}}" /></label>
        </view>
        <button class="button quiet row-action" data-index="{{index}}" bindtap="removeWindow" disabled="{{busy}}" hover-class="press">移除时段</button>
      </view>
      <view class="section-actions">
        <button class="button quiet" bindtap="addWindow" disabled="{{busy || windows.length >= 12}}" hover-class="press">添加时段</button>
        <button class="button" bindtap="saveHours" disabled="{{busy}}" hover-class="press">保存开放时段</button>
      </view>
      <view class="section-title" role="heading" aria-level="2">当天停用时段</view>
      <view wx:if="{{!exceptions.length}}" class="muted">当天没有停用记录。</view>
      <view wx:for="{{exceptions}}" wx:key="id" class="list-row">
        <view class="row-name">{{item.label}}</view>
        <view class="muted">{{item.reason}}</view>
        <button class="button quiet row-action" data-id="{{item.id}}" bindtap="removeBlock" disabled="{{busy}}" hover-class="press">解除停用</button>
      </view>
      <button wx:if="{{!blocking}}" class="button quiet row-action" bindtap="startBlock" disabled="{{busy}}" hover-class="press">新增停用时段</button>
      <form wx:else bindsubmit="saveBlock">
        <label class="form-field"><text>开始</text><input class="field" value="{{blockStart}}" data-field="blockStart" maxlength="5" bindinput="changeBlock" disabled="{{busy}}" /></label>
        <label class="form-field"><text>结束</text><input class="field" value="{{blockEnd}}" data-field="blockEnd" maxlength="5" bindinput="changeBlock" disabled="{{busy}}" /></label>
        <label class="form-field"><text>停用原因</text><input class="field" value="{{blockReason}}" data-field="blockReason" maxlength="100" bindinput="changeBlock" disabled="{{busy}}" /></label>
        <view class="section-actions">
          <button class="button quiet" bindtap="closeBlock" disabled="{{busy}}" hover-class="press">返回</button>
          <button class="button" form-type="submit" disabled="{{busy || !blockReason}}" hover-class="press">保存停用时段</button>
        </view>
      </form>
      <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    </block>
  </block>
</view>
