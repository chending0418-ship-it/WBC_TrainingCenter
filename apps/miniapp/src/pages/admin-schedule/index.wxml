<import src="../../calendar/week.wxml" />
<view wx:if="{{authorized}}" class="page-shell calendar-page">
  <view class="calendar-heading">
    <text class="page-title" role="heading" aria-level="1">{{editor ? (editor.template ? '编辑周期模板' : (editor.id ? '编辑班次' : (editor.repeat ? '新增周期模板' : '新增团课'))) : '排课管理'}}</text>
    <button wx:if="{{!editor && mode === 'classes' && !loading && !loadError}}" class="new-class" bindtap="newClass" disabled="{{busy || !coaches.length}}" hover-class="press">＋ 新增团课</button>
  </view>
  <form wx:if="{{editor}}" bindsubmit="saveClass">
    <view class="lesson-card">
      <label class="form-field"><text>课程名称</text><input class="field" value="{{editor.title}}" data-field="title" bindinput="changeClassField" maxlength="50" placeholder="输入课程名称" disabled="{{busy}}" /></label>
      <picker wx:if="{{typeOptions.length > 1}}" class="filter-row" range="{{typeOptions}}" range-key="label"
        value="{{editor.typeIndex}}" bindchange="changeCourseType" disabled="{{busy}}">
        <view class="picker"><text class="picker-label">课程类型</text><text class="picker-value">{{typeOptions[editor.typeIndex].label}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
      </picker>
      <button size="mini" class="picker coach-picker" bindtap="toggleCoachPicker" disabled="{{busy}}" aria-expanded="{{editor.coachPickerOpen}}" hover-class="press">
        <text class="picker-label">教练（可多选）</text><text class="picker-value">{{editor.coachSummary || '请选择'}}</text><view class="chevron {{editor.coachPickerOpen ? 'expanded' : ''}}" aria-hidden="true"></view>
      </button>
      <checkbox-group wx:if="{{editor.coachPickerOpen}}" bindchange="changeClassCoaches" class="coach-options" aria-label="团课教练">
        <label wx:for="{{editor.coachOptions}}" wx:key="id" class="coach-option">
          <checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy || (!item.enabled && !item.selected)}}" color="#761f32" />
          <text>{{item.name}}{{item.enabled ? '' : '（已停用）'}}</text>
        </label>
      </checkbox-group>
      <label class="form-field"><text>训练场地</text><input class="field" value="{{editor.venue}}" data-field="venue" bindinput="changeClassField" maxlength="50" disabled="{{busy}}" /></label>
    </view>
    <view class="lesson-card">
      <picker mode="date" start="{{editor.date < today ? editor.date : today}}" end="{{lastDate}}" value="{{editor.date}}" bindchange="changeClassDate" disabled="{{busy}}">
        <view class="picker"><text class="picker-label">{{editor.repeat ? '起始日期' : '开课日期'}}</text><text class="picker-value">{{editor.date}}</text><view wx:if="{{!busy}}" class="chevron" aria-hidden="true"></view></view>
      </picker>
      <view wx:if="{{!editor.id && mode !== 'templates'}}" class="row-line filter-row repeat-row"><text>按周重复</text><switch class="compact-switch" color="#761F32" checked="{{editor.repeat}}" bindchange="changeRepeat" disabled="{{busy}}" /></view>
      <view wx:if="{{editor.repeat}}">
        <view class="subheading">选择重复日期</view>
        <view class="selection-grid">
          <button wx:for="{{days}}" wx:key="index" class="button {{item.active ? '' : 'quiet'}}" data-index="{{item.index}}" bindtap="toggleDay" aria-pressed="{{item.active}}" disabled="{{busy}}" hover-class="press">{{item.label}}</button>
        </view>
      </view>
      <label class="form-field">
        <text>开课时间</text>
        <input class="field" value="{{editor.time}}" data-field="time" bindinput="changeClassField" maxlength="50" placeholder="例如 17:30" disabled="{{busy}}" />
        <view wx:if="{{editor.repeat}}" class="muted">同一天有多个时段时，用逗号分隔，例如 14:00，17:30。</view>
      </label>
      <label class="form-field"><text>时长（分钟）</text><input class="field" type="number" value="{{editor.duration}}" data-field="duration" bindinput="changeClassField" maxlength="3" disabled="{{busy}}" /></label>
    </view>
    <view class="lesson-card">
      <label class="form-field"><text>容量（人）</text><input class="field" type="number" value="{{editor.capacity}}" data-field="capacity" bindinput="changeClassField" maxlength="3" disabled="{{busy}}" /></label>
      <view wx:if="{{typeOptions[editor.typeIndex].id && editor.coachIds.length > 1}}" class="muted">已选 {{editor.coachIds.length}} 位教练，每位最多带 {{typeOptions[editor.typeIndex].maxStudents}} 人。</view>
      <label class="form-field"><text>所需积分</text><input class="field" type="number" value="{{editor.points}}" data-field="points" bindinput="changeClassField" maxlength="6" disabled="{{busy}}" /></label>
    </view>
    <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
    <view class="section-actions form-actions">
      <button class="button quiet" bindtap="closeEditor" disabled="{{busy}}" hover-class="press">返回</button>
      <button class="button" form-type="submit" loading="{{busy}}" disabled="{{busy}}" hover-class="press">保存排课</button>
    </view>
  </form>

  <block wx:else>
    <view class="calendar-tabs">
      <button class="calendar-tab {{mode === 'classes' ? 'active' : ''}}" data-mode="classes" bindtap="changeMode" aria-pressed="{{mode === 'classes'}}" hover-class="press">团课</button>
      <button class="calendar-tab {{mode === 'templates' ? 'active' : ''}}" data-mode="templates" bindtap="changeMode" aria-pressed="{{mode === 'templates'}}" hover-class="press">周期模板</button>
      <button class="calendar-tab {{mode === 'hours' ? 'active' : ''}}" data-mode="hours" bindtap="changeMode" aria-pressed="{{mode === 'hours'}}" hover-class="press">私教时段</button>
    </view>
    <view wx:if="{{loading}}" class="message">正在加载排课…</view>
    <view wx:elif="{{loadError}}" class="message">
      <view>{{loadError}}</view><button class="button quiet" bindtap="load" hover-class="press">重新查询</button>
    </view>
    <block wx:elif="{{mode === 'classes'}}">
      <template is="week" data="{{weekLabel, hasPrevious, hasNext, dates, today, lastDate, date, canPick: true, showDays: true, busy}}" />
      <view class="agenda-heading"><text class="agenda-title" role="heading" aria-level="2">班次安排</text><text class="agenda-count">{{groups.length}} 天有课 · 共 {{total}} 节</text></view>
      <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
      <view wx:if="{{!total}}" class="message">本周暂无团课，可在右上角新增。</view>
      <view wx:for="{{groups}}" wx:for-item="day" wx:key="date" id="agenda-{{day.date}}" class="agenda-day">
        <view class="agenda-stamp {{day.date === today ? 'stamp-today' : ''}}"><text class="stamp-number">{{day.day}}</text><text class="stamp-weekday">{{day.weekday}}</text></view>
        <view>
          <view wx:for="{{day.lessons}}" wx:key="id" class="agenda-card {{item.status === 'CLOSED' ? 'agenda-closed' : ''}}">
            <view class="agenda-line"><text class="agenda-time">{{item.timeLabel}}</text><text class="agenda-state">{{item.status === 'CLOSED' ? '已停开' : '已发布'}}</text></view>
            <text class="agenda-name">{{item.title}}</text>
            <view class="agenda-note">{{item.venue}} · {{item.coachLabel}}{{item.courseTypeName && item.courseTypeName !== item.title ? ' · ' + item.courseTypeName : ''}}</view>
            <view class="agenda-bottom">
              <text class="agenda-facts">已占 {{item.bookedCount}}/{{item.capacity}} 位 · {{item.points}} 积分</text>
              <button class="manage-toggle" data-id="{{item.id}}" bindtap="toggleDetails" aria-expanded="{{expandedId === item.id}}" disabled="{{busy}}" hover-class="press">{{expandedId === item.id ? '收起' : '详情'}}</button>
            </view>
            <view wx:if="{{expandedId === item.id}}" class="agenda-details">
              <view class="agenda-note">{{item.names ? '已预约：' + item.names : '暂无预约'}} · 余 {{item.capacity - item.bookedCount}} 位</view>
              <view wx:if="{{item.editable}}" class="section-actions item-actions">
                <button class="button quiet" data-id="{{item.id}}" bindtap="editClass" disabled="{{busy}}" hover-class="press">编辑班次</button>
                <button class="button quiet" data-id="{{item.id}}" bindtap="toggleClass" disabled="{{busy}}" hover-class="press">{{item.status === 'CLOSED' ? '恢复班次' : '停开班次'}}</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <block wx:elif="{{mode === 'templates'}}">
      <button class="button row-action" bindtap="newClass" disabled="{{busy || !coaches.length}}" hover-class="press">新增周期模板</button>
      <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
      <view wx:if="{{!templates.length}}" class="message">还没有周期排课模板。</view>
      <view wx:for="{{templates}}" wx:key="id" class="lesson-card">
        <view class="card-head"><text class="card-title">{{item.title}}</text><text class="card-state">{{item.enabled ? '已启用' : '已停用'}}</text></view>
        <view class="card-time">{{item.timetable}}</view>
        <view class="muted">{{item.coachLabel}} · {{item.venue}} · {{item.points}} 积分</view>
        <view class="section-actions item-actions">
          <button class="button quiet" data-id="{{item.id}}" bindtap="editTemplate" disabled="{{busy}}" hover-class="press">编辑模板</button>
          <button class="button quiet" data-id="{{item.id}}" bindtap="toggleTemplate" disabled="{{busy}}" hover-class="press">{{item.enabled ? '停用模板' : '启用模板'}}</button>
        </view>
      </view>
    </block>
    <block wx:elif="{{coaches.length}}">
      <picker class="filter-row" range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="changeHoursCoach" disabled="{{busy || editingWeekday >= 0}}">
        <view class="picker"><text class="picker-label">教练</text><text class="picker-value">{{coaches[coachIndex].name}}教练</text><view wx:if="{{!(busy || editingWeekday >= 0)}}" class="chevron" aria-hidden="true"></view></view>
      </picker>
      <view class="section-title" role="heading" aria-level="2">每周固定开放时间</view>
      <view class="lesson-card weekly-hours">
        <view wx:for="{{weeklyHours}}" wx:key="weekday" wx:for-item="day" class="weekday-row">
          <view class="weekday-summary">
            <text class="row-name">{{day.label}}</text>
            <text wx:if="{{editingWeekday !== day.weekday}}" class="{{day.windows.length ? 'weekday-times' : 'card-note'}}">{{day.summary || '未开放'}}</text>
            <button wx:if="{{editingWeekday < 0 && !blocking}}" class="button quiet edit-day" data-weekday="{{day.weekday}}"
              bindtap="editWeekday" aria-label="编辑{{day.label}}开放时间" disabled="{{busy}}" hover-class="press">编辑</button>
          </view>
          <block wx:if="{{editingWeekday === day.weekday}}">
            <view wx:for="{{windows}}" wx:key="key" class="window-editor">
              <input class="field" value="{{item.start}}" data-index="{{index}}" data-side="start" aria-label="开始时间" placeholder="开始时间" maxlength="5" bindinput="changeWindow" disabled="{{busy}}" />
              <text class="card-note">至</text>
              <input class="field" value="{{item.end}}" data-index="{{index}}" data-side="end" aria-label="结束时间" placeholder="结束时间" maxlength="5" bindinput="changeWindow" disabled="{{busy}}" />
              <button class="button quiet hours-link" data-index="{{index}}" bindtap="removeWindow" aria-label="移除第{{index + 1}}个时段" disabled="{{busy}}" hover-class="press">移除</button>
            </view>
            <view wx:if="{{!windows.length}}" class="card-note">当天未设开放时段</view>
            <view wx:if="{{saveError}}" class="form-error">{{saveError}}</view>
            <view class="hours-actions">
              <button class="button quiet hours-link add-window" bindtap="addWindow" disabled="{{busy || windows.length >= 12}}" hover-class="press">＋ 添加时段</button>
              <button class="button quiet hours-link" bindtap="closeHours" disabled="{{busy}}" hover-class="press">取消</button>
              <button class="button save-hours" bindtap="saveHours" aria-label="保存{{day.label}}开放时间" disabled="{{busy}}" hover-class="press">保存</button>
            </view>
          </block>
        </view>
      </view>
      <block wx:if="{{editingWeekday < 0}}">
        <view class="section-title" role="heading" aria-level="2">指定日期停用</view>
        <picker mode="date" start="{{today}}" end="{{lastDate}}" value="{{date}}" bindchange="changeDate" disabled="{{busy || editingWeekday >= 0}}">
          <view class="picker"><text class="picker-label">日期</text><text class="picker-value">{{date}} · {{dayLabel}}</text><view wx:if="{{!(busy || editingWeekday >= 0)}}" class="chevron" aria-hidden="true"></view></view>
        </picker>
        <view wx:if="{{!exceptions.length}}" class="muted">当天没有停用记录。</view>
        <view wx:for="{{exceptions}}" wx:key="id" class="lesson-card">
          <view class="card-time">{{item.label}}</view>
          <view class="muted">{{item.reason}}</view>
          <button class="button quiet row-action" data-id="{{item.id}}" bindtap="removeBlock" disabled="{{busy}}" hover-class="press">解除停用</button>
        </view>
        <button wx:if="{{!blocking}}" class="button quiet row-action" bindtap="startBlock" disabled="{{busy}}" hover-class="press">新增停用时段</button>
        <form wx:else class="lesson-card" bindsubmit="saveBlock">
          <label class="form-field first-field"><text>开始</text><input class="field" value="{{blockStart}}" data-field="blockStart" maxlength="5" bindinput="changeBlock" disabled="{{busy}}" /></label>
          <label class="form-field"><text>结束</text><input class="field" value="{{blockEnd}}" data-field="blockEnd" maxlength="5" bindinput="changeBlock" disabled="{{busy}}" /></label>
          <label class="form-field"><text>停用原因</text><input class="field" value="{{blockReason}}" data-field="blockReason" maxlength="100" bindinput="changeBlock" disabled="{{busy}}" /></label>
          <view class="section-actions form-actions">
            <button class="button quiet" bindtap="closeBlock" disabled="{{busy}}" hover-class="press">返回</button>
            <button class="button" form-type="submit" disabled="{{busy || !blockReason}}" hover-class="press">保存停用时段</button>
          </view>
        </form>
      </block>
      <view wx:if="{{saveError && editingWeekday < 0}}" class="form-error">{{saveError}}</view>
    </block>
    <view wx:else class="message">请先在「教练管理」添加或启用教练，再设置私教时段。</view>
  </block>
</view>
