.balance {
  padding: 15px 17px;
  border-radius: 11px;
  background: #761f32;
  color: #fff;
}

.balance-number {
  display: block;
  margin: 2px 0 5px;
  font-size: 36px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}


.balance > view:last-child:not(:first-child) { font-size: 13px; color: #f8e9ec; }
