.balance { padding: 16px 18px; border-radius: 12px; background: #761f32; color: #fff; }
.balance-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 600; }
.balance-number { font-size: 34px; font-weight: 700; line-height: 1.15; }
.balance-reserved { border-top: 1px solid #9a5564; margin-top: 12px; padding-top: 10px; font-size: 13px; color: #fff3f5; }
