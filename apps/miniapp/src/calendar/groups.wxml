<template name="courseSummary">
  <view class="agenda-line"><text class="agenda-time">{{item.hours}}</text><text wx:if="{{showBooking && item.unavailable}}" class="agenda-state">{{item.action}}</text><text wx:elif="{{item.hasStarted}}" class="agenda-state">已开课</text></view>
  <text class="agenda-name">{{item.title}}</text>
  <view class="agenda-note">{{item.venue}} · {{item.coachLabel}}{{item.courseTypeName && item.courseTypeName !== item.title ? ' · ' + item.courseTypeName : ''}}</view>
</template>

<template name="groups">
  <view class="agenda-heading">
    <text class="agenda-title" role="heading" aria-level="2">团课安排</text>
    <text class="agenda-count">{{groups.length}} 天有课 · 共 {{total}} 节</text>
  </view>
  <view wx:if="{{!total}}" class="message">本周暂无团课，可切换周次查看。</view>
  <view wx:for="{{groups}}" wx:for-item="day" wx:key="date" id="agenda-{{day.date}}" class="agenda-day">
    <view class="agenda-stamp {{day.date === today ? 'stamp-today' : ''}}">
      <text class="stamp-number">{{day.day}}</text><text class="stamp-weekday">{{day.weekday}}</text>
    </view>
    <view>
      <block wx:for="{{day.lessons}}" wx:key="id">
        <button wx:if="{{!showBooking && !item.hasStarted}}" class="agenda-card public-course" aria-label="{{'查看' + item.title + '，' + item.hours + '，' + item.venue + '，' + item.coachLabel}}" data-id="{{item.id}}" bindtap="openCourse" hover-class="press">
          <template is="courseSummary" data="{{item}}" />
          <view class="agenda-bottom public-actions"><text class="reserve">查看课程</text></view>
        </button>
        <view wx:elif="{{!showBooking}}" class="agenda-card"><template is="courseSummary" data="{{item}}" /></view>
        <view wx:else class="agenda-card">
          <template is="courseSummary" data="{{item, showBooking}}" />
          <view class="agenda-bottom">
            <text class="agenda-facts">{{item.points}} 积分 · 余 {{item.capacity - item.bookedCount}}/{{item.capacity}} 位</text>
            <button wx:if="{{!item.unavailable}}" class="reserve" data-id="{{item.id}}" bindtap="bookGroup" disabled="{{booking}}" hover-class="press" aria-label="预约{{item.title}}">预约</button>
          </view>
        </view>
      </block>
    </view>
  </view>
</template>
