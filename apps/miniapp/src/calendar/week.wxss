.page-shell.calendar-page {
  padding-left: 4vw;
  padding-right: 4vw;
}
.calendar-page .page-title { margin: 0; }
.calendar-heading, .agenda-heading, .agenda-line, .agenda-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.6vw;
}
.calendar-heading { min-height: 9.067vw; }
.calendar-tabs { display: flex; gap: 4.8vw; border-bottom: 1rpx solid #ded5d3; margin: 2.133vw 0 2.667vw; }
.calendar-tabs .calendar-tab, .week-panel button, .agenda-card .manage-toggle, .calendar-heading .new-class {
  box-sizing: border-box;
  margin: 0;
  width: auto;
  border: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: inherit;
  line-height: 1.4;
}
.calendar-tab::after, .week-panel button::after, .manage-toggle::after, .new-class::after, .reserve::after { border: 0; }
.calendar-tabs .calendar-tab {
  display: flex; align-items: center; min-height: 10.4vw;
  border-bottom: 0.667vw solid transparent;
  color: #66595c; font-size: 3.867vw;
}
.calendar-tabs .active { color: #761f32; border-bottom-color: #761f32; font-weight: 650; }
.week-panel {
  padding: 1.867vw 2.4vw 2.133vw;
  background: #761f32;
  color: #fff;
  border-radius: 2.667vw;
}
.week-head { display: flex; align-items: center; justify-content: space-between; padding-left: 1.6vw; }
.week-caption { font-size: 19px; line-height: 1.3; font-weight: 650; }
.week-picker { display: flex; align-items: center; gap: 1.6vw; min-height: 9.333vw; }
.picker-caret { width: 0; height: 0; border: 1.067vw solid transparent; border-bottom: 0; border-top-color: #f0e4e5; }
.week-nav { display: flex; }
.week-nav .week-arrow { display: flex; align-items: center; justify-content: center; width: 10.133vw; min-height: 9.867vw; color: #fff; }
.week-nav .week-arrow[disabled] { color: #d5a9b4; background: transparent; }
.arrow-icon { box-sizing: border-box; width: 2vw; height: 2vw; border: solid currentColor; border-width: 0.4vw 0.4vw 0 0; transform: rotate(45deg); }
.arrow-icon.back { transform: rotate(-135deg); }
.week-strip { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding-top: 1.6vw; border-top: 1rpx solid #98566a; }
.week-strip .week-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; padding: 0.8vw 0 0.533vw; color: white; }
.week-strip .week-cell[disabled] { opacity: .45; background: transparent; color: white; }
.cell-weekday { color: #f8e9ec; font-size: 2.933vw; }
.cell-date { display: block; border-radius: 50%; min-width: 6.4vw; line-height: 6.4vw; font-size: 4.267vw; font-weight: 650; text-align: center; }
.is-today .cell-date { color: #761f32; background: #fff; }
.cell-mark { height: 0.933vw; width: 0.933vw; margin-top: 0.533vw; border-radius: 50%; }
.has-lessons { background: #f8e9ec; }
.agenda-heading { margin: 3.733vw 0 1.867vw; }
.agenda-title { font-size: 4.267vw; font-weight: 650; }
.agenda-count { color: #66595c; font-size: 3.2vw; }
.agenda-day { display: grid; grid-template-columns: 8.8vw minmax(0, 1fr); gap: 1.867vw; margin-bottom: 2.4vw; }
.agenda-stamp { display: flex; flex-direction: column; align-items: center; padding-top: 0.8vw; }
.stamp-number { font-size: 5.6vw; font-weight: 650; line-height: 1.15; font-variant-numeric: tabular-nums; }
.stamp-weekday { color: #66595c; font-size: 3.067vw; }
.stamp-today .stamp-number, .stamp-today .stamp-weekday { color: #761f32; }
.agenda-card { box-sizing: border-box; min-width: 0; background: #fff; border: 1rpx solid #ded5d3; border-left: 1px solid #d5c4c5; border-radius: 1.6vw; padding: 1.733vw 2.4vw; }
.agenda-card + .agenda-card { margin-top: 1.2vw; }
.agenda-time { color: #761f32; font-size: 3.467vw; line-height: 1.4; font-weight: 650; font-variant-numeric: tabular-nums; }
.agenda-name { display: block; margin: 0.4vw 0; font-size: 4.133vw; line-height: 1.35; font-weight: 650; overflow-wrap: anywhere; }
.agenda-note, .agenda-facts, .agenda-state { color: #66595c; font-size: 3.2vw; line-height: 1.45; overflow-wrap: anywhere; }
.agenda-state { white-space: nowrap; }
.agenda-bottom { margin-top: 0.667vw; }
.agenda-card .reserve, .calendar-heading .new-class {
  display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 2.533vw;
  flex-shrink: 0; width: auto; min-height: 7.733vw; border-radius: 1.333vw;
  background: #761f32; color: #fff; font-size: 3.333vw; font-weight: 600; line-height: 1.3;
}
.agenda-card .manage-toggle { color: #761f32; font-weight: 600; font-size: 3.333vw; min-height: 7.733vw; min-width: 10.133vw; }
.agenda-details { border-top: 1rpx solid #e6dfdc; margin-top: 1.067vw; padding-top: 1.6vw; }
.agenda-details .item-actions { margin: 1.6vw 0 0; }
.agenda-closed { background: #f0eae8; border-left-color: #d5c4c5; }
.calendar-page .new-class[disabled] { color: #6c6063; background: #ede7e5; }

.calendar-page .calendar-heading { margin-bottom: 8px; }
