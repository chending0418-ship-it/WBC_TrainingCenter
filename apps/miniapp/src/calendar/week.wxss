.page-shell.calendar-page {
  padding-left: 30rpx;
  padding-right: 30rpx;
}
.calendar-page .page-title { margin: 0; }
.calendar-heading, .agenda-heading, .agenda-line, .agenda-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.calendar-heading { min-height: 68rpx; }
.calendar-tabs { display: flex; gap: 36rpx; border-bottom: 1rpx solid #ded5d3; margin: 16rpx 0 20rpx; }
.calendar-tabs .calendar-tab, .week-panel button, .agenda-card .manage-toggle, .calendar-heading .new-class {
  box-sizing: border-box;
  margin: 0;
  width: auto;
  border: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: inherit;
  line-height: 1.4;
}
.calendar-tab::after, .week-panel button::after, .manage-toggle::after, .new-class::after, .reserve::after { border: 0; }
.calendar-tabs .calendar-tab {
  display: flex; align-items: center; min-height: 78rpx;
  border-bottom: 5rpx solid transparent;
  color: #66595c; font-size: 29rpx;
}
.calendar-tabs .active { color: #761f32; border-bottom-color: #761f32; font-weight: 650; }
.week-panel {
  padding: 14rpx 18rpx 16rpx;
  background: #761f32;
  color: #fff;
  border-radius: 20rpx;
}
.week-head { display: flex; align-items: center; justify-content: space-between; padding-left: 12rpx; }
.week-caption { font-size: 19px; line-height: 1.3; font-weight: 650; }
.week-picker { display: flex; align-items: center; gap: 12rpx; min-height: 70rpx; }
.picker-caret { width: 0; height: 0; border: 8rpx solid transparent; border-bottom: 0; border-top-color: #f0e4e5; }
.week-nav { display: flex; }
.week-nav .week-arrow { display: flex; align-items: center; justify-content: center; width: 76rpx; min-height: 74rpx; color: #fff; }
.week-nav .week-arrow[disabled] { color: #d5a9b4; background: transparent; }
.arrow-icon { box-sizing: border-box; width: 15rpx; height: 15rpx; border: solid currentColor; border-width: 3rpx 3rpx 0 0; transform: rotate(45deg); }
.arrow-icon.back { transform: rotate(-135deg); }
.week-strip { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding-top: 12rpx; border-top: 1rpx solid #98566a; }
.week-strip .week-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; padding: 6rpx 0 4rpx; color: white; }
.week-strip .week-cell[disabled] { opacity: .45; background: transparent; color: white; }
.cell-weekday { color: #f8e9ec; font-size: 22rpx; }
.cell-date { display: block; border-radius: 50%; min-width: 48rpx; line-height: 48rpx; font-size: 32rpx; font-weight: 650; text-align: center; }
.is-today .cell-date { color: #761f32; background: #fff; }
.cell-mark { height: 7rpx; width: 7rpx; margin-top: 4rpx; border-radius: 50%; }
.has-lessons { background: #f8e9ec; }
.agenda-heading { margin: 28rpx 0 14rpx; }
.agenda-title { font-size: 32rpx; font-weight: 650; }
.agenda-count { color: #66595c; font-size: 24rpx; }
.agenda-day { display: grid; grid-template-columns: 66rpx minmax(0, 1fr); gap: 14rpx; margin-bottom: 18rpx; }
.agenda-stamp { display: flex; flex-direction: column; align-items: center; padding-top: 6rpx; }
.stamp-number { font-size: 42rpx; font-weight: 650; line-height: 1.15; font-variant-numeric: tabular-nums; }
.stamp-weekday { color: #66595c; font-size: 23rpx; }
.stamp-today .stamp-number, .stamp-today .stamp-weekday { color: #761f32; }
.agenda-card { box-sizing: border-box; min-width: 0; background: #fff; border: 1rpx solid #ded5d3; border-left: 1px solid #d5c4c5; border-radius: 12rpx; padding: 13rpx 18rpx; }
.agenda-card + .agenda-card { margin-top: 9rpx; }
.agenda-time { color: #761f32; font-size: 26rpx; line-height: 1.4; font-weight: 650; font-variant-numeric: tabular-nums; }
.agenda-name { display: block; margin: 3rpx 0; font-size: 31rpx; line-height: 1.35; font-weight: 650; overflow-wrap: anywhere; }
.agenda-note, .agenda-facts, .agenda-state { color: #66595c; font-size: 24rpx; line-height: 1.45; overflow-wrap: anywhere; }
.agenda-state { white-space: nowrap; }
.agenda-bottom { margin-top: 5rpx; }
.agenda-card .reserve, .calendar-heading .new-class {
  display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 19rpx;
  flex-shrink: 0; width: auto; min-height: 58rpx; border-radius: 10rpx;
  background: #761f32; color: #fff; font-size: 25rpx; font-weight: 600; line-height: 1.3;
}
.agenda-card .manage-toggle { color: #761f32; font-weight: 600; font-size: 25rpx; min-height: 58rpx; min-width: 76rpx; }
.agenda-details { border-top: 1rpx solid #e6dfdc; margin-top: 8rpx; padding-top: 12rpx; }
.agenda-details .item-actions { margin: 12rpx 0 0; }
.agenda-closed { background: #f0eae8; border-left-color: #d5c4c5; }
.calendar-page .new-class[disabled] { color: #6c6063; background: #ede7e5; }

.calendar-page .calendar-heading { margin-bottom: 8px; }
