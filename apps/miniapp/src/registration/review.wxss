.enrollment .page-title { margin-bottom: 18px; }
.en-sub, .en-heading {
  margin: 24px 0 9px;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.4;
}
.en-heading, .en-actions, .en-meta, .en-person, .en-tabs { display: flex; align-items: center; }
.en-heading, .en-meta, .en-person { justify-content: space-between; gap: 8px; }
.en-heading .en-link { color: #761f32; font-size: 13px; font-weight: 400; line-height: 1.55; }
.en-heading.en-results { margin: 22px 0 9px; }
.en-hint, .en-state-note { font-size: 14px; line-height: 1.65; color: #66595c; }
.en-hint { margin: 7px 0 15px; }
.en-back { display: flex; align-items: center; gap: 7px; margin-bottom: 16px; color: #761f32; font-size: 14px; }
.en-back::before { content: ''; box-sizing: border-box; width: 8px; height: 8px; border: solid currentColor; border-width: 0 0 1.5px 1.5px; transform: rotate(45deg); }
.en-summary, .en-course, .en-list, .en-textarea { border-radius: 10px; border: 1px solid #ded5d3; background: #fff; overflow: hidden; }
.en-meta { align-items: baseline; gap: 12px; padding: 10px 13px; }
.en-meta + .en-meta, .en-person + .en-person { border-top: 1px solid #e6dfdc; }
.en-meta text:first-child { font-size: 14px; color: #66595c; }
.en-meta text:last-child { text-align: right; font-weight: 700; overflow-wrap: anywhere; }
.en-actions { justify-content: flex-end; gap: 10px; margin-top: 20px; }
.en-actions .button { display: block; flex: none; width: auto; margin: 0; padding: 8px 14px; font-size: 14px; line-height: 1.45; }
.en-state { background: #f0e4e5; padding: 15px 16px; border-radius: 9px; margin: 12px 0; }
.en-state-title { color: #761f32; font-size: 19px; font-weight: 700; }
.en-state-note { margin-top: 5px; }
.en-course { padding: 12px 14px; }
.en-course-title, .en-person-name { display: block; font-weight: 700; }
.en-person-name { font-size: 16px; }
.en-person-note, .en-status { display: block; color: #66595c; font-size: 13px; }
.en-tabs { gap: 22px; margin: 12px 0; border-bottom: 1px solid #ded5d3; }
.en-tabs text { padding: 8px 0; color: #66595c; }
.en-tabs .on { border-bottom: 2px solid #761f32; color: #761f32; font-weight: 700; }
.en-person { padding: 13px 14px; }
.en-status { display: flex; align-items: center; gap: 10px; text-align: right; }
.en-status::after { content: ''; box-sizing: border-box; width: 7px; height: 7px; border: solid #9a878b; border-width: 1.5px 1.5px 0 0; transform: rotate(45deg); }
.en-textarea { box-sizing: border-box; width: 100%; height: 112px; padding: 12px 14px; font: inherit; }
