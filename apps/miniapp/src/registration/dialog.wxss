.quote-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 4.8vw;
  background: rgba(30, 23, 25, .45);
}

.quote-dialog {
  box-sizing: border-box;
  width: 100%;
  max-height: 90%;
  overflow: auto;
  padding: 4vw;
  border-radius: 24rpx;
  background: #fff;
  text-align: left;
}

.quote-dialog.registration-dialog { max-width: 400px; margin: 0 auto; padding: 18px; border-radius: 12px; }
.registration-dialog .card-title { margin-bottom: 12px; font-size: 20px; font-weight: 700; line-height: 1.55; }
.registration-course { border: 1px solid #ded5d3; border-radius: 10px; padding: 12px 14px; }
.registration-course text { display: block; }
.registration-course .row-name { font-size: 15px; line-height: 1.55; font-weight: 700; }
.registration-dialog > .card-note { margin: 14px 0; color: #272327; font-size: 14px; line-height: 1.55; }
.registration-dialog .quote-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
.registration-dialog .quote-actions .button { flex: none; width: auto; margin: 0; }
