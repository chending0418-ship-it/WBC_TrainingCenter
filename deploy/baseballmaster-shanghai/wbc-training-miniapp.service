[Unit]
Description=WBC Training Miniapp API
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=wbc-training-miniapp
StateDirectoryMode=0700
WorkingDirectory=/opt/wbc-training-miniapp/current
Environment=NODE_ENV=production
Environment=WBC_DB_PATH=/var/lib/wbc-training-miniapp/wbc.sqlite
Environment=WBC_PORT=19310
ExecStart=/opt/baseballmaster-node/node-v24.21.0-linux-x64/bin/node apps/api/src/server.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
